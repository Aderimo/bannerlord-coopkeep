<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             x:Class="CoopKeep.App.Views.Pages.SettingsPage"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
        <!-- Vurgu rengi yuvarlağı: seçiliyken çevresinde halka -->
        <Style Selector="RadioButton.swatch">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="ring" Width="36" Height="36" CornerRadius="18" BorderThickness="2" BorderBrush="Transparent"
                            Background="Transparent" Cursor="Hand">
                        <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.swatch:pointerover /template/ Border#ring">
            <Setter Property="BorderBrush" Value="{StaticResource BorderHover}" />
        </Style>
        <Style Selector="RadioButton.swatch:checked /template/ Border#ring">
            <Setter Property="BorderBrush" Value="{StaticResource TextMain}" />
        </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,40" Spacing="18" MaxWidth="820">

        <StackPanel Classes="enter" Spacing="4">
            <TextBlock Classes="display" Text="{Binding L[settings.title]}" />
        </StackPanel>

        <!-- Güncelleme -->
        <Border Classes="card enter" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentDim}"
                IsVisible="{Binding HasUpdate}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Classes="body" VerticalAlignment="Center" Text="{Binding UpdateText}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Classes="primary" Command="{Binding InstallUpdateCommand}" IsVisible="{Binding CanSelfUpdate}"
                            Content="{Binding L[update.install]}" ToolTip.Tip="{Binding L[update.installTip]}" />
                    <Button Command="{Binding OpenReleasePageCommand}" Content="{Binding L[update.download]}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ GÖRÜNÜM ============ -->
        <Border Classes="card enter">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Classes="h2" Text="{Binding L[theme.title]}" />
                    <TextBlock Classes="hint" Text="{Binding L[theme.hint]}" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding ThemeBases}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOption">
                            <RadioButton Classes="choice" GroupName="themeBase" Margin="0,0,10,0" IsChecked="{Binding IsSelected}">
                                <StackPanel Spacing="8">
                                    <Border CornerRadius="6" Height="34" ClipToBounds="True" Background="{Binding Preview}"
                                            BorderThickness="1" BorderBrush="{StaticResource BorderDim}">
                                        <Grid ColumnDefinitions="*,*,10" Margin="6">
                                            <Border CornerRadius="3" Background="{Binding Preview2}" Margin="0,0,4,0" />
                                            <Border Grid.Column="1" CornerRadius="3" Background="{Binding Preview2}" Margin="0,0,4,0" />
                                            <Border Grid.Column="2" CornerRadius="3" Background="{Binding Preview3}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" HorizontalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock FontWeight="SemiBold" FontSize="13.5" Text="{Binding L[theme.accentTitle]}" />
                <ItemsControl ItemsSource="{Binding ThemeAccents}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ThemeOption">
                            <RadioButton Classes="swatch" GroupName="themeAccent" Margin="0,0,10,8" IsChecked="{Binding IsSelected}"
                                         ToolTip.Tip="{Binding Name}">
                                <Ellipse Width="26" Height="26" Fill="{Binding Preview}" />
                            </RadioButton>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Border Height="1" Background="{StaticResource BorderDim}" />
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2" VerticalAlignment="Center">
                        <TextBlock FontWeight="SemiBold" FontSize="13.5" Text="{Binding L[settings.advanced]}" />
                        <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding L[settings.advancedHint]}" />
                    </StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AdvancedMode}" OnContent="" OffContent="" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ SUNUCU ============ -->
        <Border Classes="card enter d1">
            <StackPanel Spacing="16">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h2" Text="{Binding L[settings.server]}" />
                    <TextBlock Classes="hint" Text="{Binding L[msg.settingsNeedRestart]}" />
                </StackPanel>

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.passwordHint]}"><TextBlock Text="{Binding L[lbl.password]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <TextBox Grid.Column="1" Width="240" Text="{Binding EditPassword}" PasswordChar="•"
                             RevealPassword="{Binding !PrivacyMode}" IsEnabled="{Binding !IsRunning}"
                             VerticalAlignment="Center" />
                </Grid>


                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[msg.autosaveHint]}"><TextBlock Text="{Binding L[lbl.autosave]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <TextBox Grid.Column="1" Classes="bar" Text="{Binding EditAutosave}" IsEnabled="{Binding !IsRunning}"
                             VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.portHint]}"><TextBlock Text="{Binding L[lbl.port]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <TextBox Grid.Column="1" Classes="bar" Text="{Binding EditPort}" IsEnabled="{Binding !IsRunning}"
                             VerticalAlignment="Center" />
                </Grid>

                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.steamHint]}"><TextBlock Text="{Binding L[lbl.steam]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding EditSteam}" IsEnabled="{Binding !IsRunning}" VerticalAlignment="Center" />
                </Grid>

                <Button HorizontalAlignment="Right" Classes="primary" Command="{Binding ApplySettingsCommand}"
                        Content="{Binding L[btn.saveSettings]}" />
            </StackPanel>
        </Border>

        <!-- ============ OTOMASYON ============ -->
        <Border Classes="card enter d2">
            <StackPanel Spacing="16">
                <TextBlock Classes="h2" Text="{Binding L[settings.automation]}" />
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.joinAlertHint]}"><TextBlock Text="{Binding L[settings.joinAlert]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding JoinAlert}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.autoRestartHint]}"><TextBlock Text="{Binding L[lbl.autoRestart]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoRestart}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.restartCountdownHint]}"><TextBlock Text="{Binding L[settings.restartCountdown]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding RestartWithCountdownCommand}"
                            Content="{Binding L[btn.restartCountdown]}" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.priorityHint]}"><TextBlock Text="{Binding L[settings.priority]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding HighPriority}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.memoryHint]}"><TextBlock Text="{Binding L[settings.memory]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <ComboBox Grid.Column="1" Width="110" VerticalAlignment="Center" ItemsSource="{Binding MemoryWarningOptions}"
                              SelectedItem="{Binding MemoryWarningGb}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="x:Int32">
                                <TextBlock Text="{Binding Converter={x:Static vm:Formatters.GigabyteOption}}" />
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.updatesHint]}"><TextBlock Text="{Binding L[settings.updates]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding CheckUpdates}" VerticalAlignment="Center" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ SUNUCU EKLENTİSİ (eski Coop sunucusu) ============ -->

        <!-- ============ HARİTA PAYLAŞIMI (eski Coop sunucusunun canlı verisiyle) ============ -->

        <!-- ============ KURULUM ============ -->
        <Border Classes="card enter d3">
            <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="{Binding L[settings.install]}" />
                <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">
                    <TextBlock Classes="dim" Text="Bannerlord" />
                    <TextBlock Grid.Column="1" Classes="value" Text="{Binding GameVersion}" />
                    <TextBlock Grid.Row="1" Classes="dim" Margin="0,6,0,0" Text="{Binding L[settings.install.mod]}" />
                    <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Margin="0,6,0,0" Text="{Binding ModVersion}" />
                    <TextBlock Grid.Row="2" Classes="dim" Margin="0,6,0,0" Text="{Binding L[settings.install.app]}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Margin="0,6,0,0" Text="{Binding AppVersion}" />
                </Grid>
            </StackPanel>
        </Border>

        <!-- ============ GELİŞTİRİCİ VE İLETİŞİM ============ -->
        <Border Classes="card enter d3" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentDim}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="42" Height="42" CornerRadius="21" Background="{StaticResource BgRaised}" VerticalAlignment="Center">
                    <Path Data="{StaticResource IconHeart}" Stroke="{StaticResource Accent}" StrokeThickness="1.8" Width="18" Height="18" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0" Spacing="4" VerticalAlignment="Center">
                    <TextBlock Classes="h2" Text="{Binding L[about.title]}" />
                    <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding L[about.body]}" />
                </StackPanel>
                <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" Command="{Binding OpenAuthorPageCommand}" ToolTip.Tip="{Binding AuthorUrl}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Data="{StaticResource IconGlobe}" Stroke="{StaticResource OnAccent}" StrokeThickness="1.8" Width="14" Height="14" Stretch="Uniform" />
                        <TextBlock Text="{Binding AuthorLinkText}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- ============ YARDIM ============ -->
        <Border Classes="card enter d3">
            <StackPanel Spacing="14">
                <TextBlock Classes="h2" Text="{Binding L[settings.help]}" />
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.reportHint]}"><TextBlock Text="{Binding L[settings.report]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding CreateBugReportCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Data="{StaticResource IconBug}" Width="15" />
                            <TextBlock Text="{Binding L[btn.createReport]}" />
                        </StackPanel>
                    </Button>
                </Grid>
                <WrapPanel>
                    <Button Margin="0,0,8,0" Command="{Binding ShowWelcomeCommand}" Content="{Binding L[btn.showWelcome]}" />
                    <Button Margin="0,0,8,0" Command="{Binding OpenLogsFolderCommand}" Content="{Binding L[btn.openLogs]}" />
                    <Button Command="{Binding OpenSavesFolderCommand}" Content="{Binding L[btn.openFolder]}" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Coop modu: durum, oyunu açma, sunucu araçları, Nexus anahtarı -->
        <Border Classes="card enter d3">
            <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="{Binding L[settings.mod]}" />
                <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Classes="body" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding CoopStatusText}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding OpenCoopFolderCommand}" Content="{Binding L[coop.openFolder]}" />
                        <Button Command="{Binding LaunchCoopCommand}" Content="{Binding L[coop.launchPlain]}" />
                    </StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[tools.hint]}"><TextBlock Text="{Binding L[tools.title]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding ServerToolsEnabled}" VerticalAlignment="Center" />
                </Grid>
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[mm.nexusKeyHint]}"><TextBlock Text="{Binding L[mm.nexusKey]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <TextBox Width="220" Text="{Binding NexusApiKey}" PasswordChar="•" />
                        <Button Command="{Binding CheckNexusKeyCommand}" Content="{Binding L[mm.nexusCheck]}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
