<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             xmlns:saves="using:CoopKeep.Core.Saves"
             x:Class="CoopKeep.App.Views.Pages.BackupsPage"
             x:DataType="vm:MainViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,40" Spacing="16" MaxWidth="1080">

        <Grid Classes="enter" ColumnDefinitions="*,Auto,Auto">
            <TextBlock Classes="display" Text="{Binding L[nav.backups]}" VerticalAlignment="Center" />
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="0,0,16,0" VerticalAlignment="Center"
                        ToolTip.Tip="{Binding L[msg.backupHint]}">
                <TextBlock Classes="dim" Text="{Binding L[lbl.autoBackup]}" VerticalAlignment="Center" />
                <ToggleSwitch IsChecked="{Binding AutoBackup}" />
            </StackPanel>
            <Button Grid.Column="2" Classes="primary" VerticalAlignment="Center" Command="{Binding BackupNowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{StaticResource IconArchive}" />
                    <TextBlock Text="{Binding L[btn.backupNow]}" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- Kapsam: seçili dünya / tüm dünyalar -->
        <UniformGrid Classes="enter d1" Columns="2" HorizontalAlignment="Left" Width="420">
            <RadioButton Classes="choice scope" GroupName="backupScope" IsChecked="{Binding BackupsShowSelected}" Margin="0,0,4,0">
                <StackPanel Spacing="1">
                    <TextBlock Text="{Binding L[backups.thisWorld]}" FontWeight="SemiBold" />
                    <TextBlock Classes="dim" FontSize="11.5" Text="{Binding SelectedCampaign.Name, FallbackValue='—'}" />
                </StackPanel>
            </RadioButton>
            <RadioButton Classes="choice scope" GroupName="backupScope" IsChecked="{Binding BackupsShowAll}" Margin="4,0,0,0">
                <TextBlock Text="{Binding L[backups.allWorlds]}" FontWeight="SemiBold" VerticalAlignment="Center" />
            </RadioButton>
        </UniformGrid>

        <Border Classes="card enter d2" Padding="8">
            <StackPanel>
                <Grid ColumnDefinitions="2*,1.4*,*,*,80" Margin="12,6,12,8">
                    <TextBlock Classes="dim" FontSize="11.5" Text="{Binding L[backups.col.world]}" />
                    <TextBlock Grid.Column="1" Classes="dim" FontSize="11.5" Text="{Binding L[backups.col.date]}" />
                    <TextBlock Grid.Column="2" Classes="dim" FontSize="11.5" Text="{Binding L[backups.col.time]}" />
                    <TextBlock Grid.Column="3" Classes="dim" FontSize="11.5" Text="{Binding L[backups.col.reason]}" />
                    <TextBlock Grid.Column="4" Classes="dim" FontSize="11.5" Text="{Binding L[backups.col.size]}" HorizontalAlignment="Right" />
                </Grid>

                <StackPanel Margin="12" Spacing="6" IsVisible="{Binding !HasBackups}">
                    <TextBlock Classes="hint" Text="{Binding L[msg.noBackups]}" />
                    <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding L[empty.backups]}" />
                </StackPanel>

                <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="440"
                         IsVisible="{Binding HasBackups}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="saves:BackupEntry">
                            <Grid ColumnDefinitions="2*,1.4*,*,*,80">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <Path Data="{StaticResource IconGlobe}" Stroke="{StaticResource Accent}" StrokeThickness="1.5"
                                          Width="14" Height="14" Stretch="Uniform" />
                                    <TextBlock FontWeight="SemiBold" Text="{Binding SaveName}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding CreatedLocal, StringFormat='{}{0:dd MMMM yyyy}'}" />
                                <TextBlock Grid.Column="2" Text="{Binding CreatedLocal, StringFormat='{}{0:HH:mm:ss}'}" />
                                <TextBlock Grid.Column="3" Classes="dim" Text="{Binding Reason, Converter={x:Static vm:Formatters.BackupReasonText}}" />
                                <TextBlock Grid.Column="4" Classes="dim" HorizontalAlignment="Right"
                                           Text="{Binding SizeBytes, Converter={x:Static vm:Formatters.FileSize}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid ColumnDefinitions="*,Auto" Margin="12,10,12,6" IsVisible="{Binding !PendingRestore}">
                    <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding L[msg.stopToRestore]}" IsVisible="{Binding IsRunning}" />
                    <Button Grid.Column="1" Command="{Binding RequestRestoreCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="14" />
                            <TextBlock Text="{Binding L[btn.restore]}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Classes="enter" Margin="4" IsVisible="{Binding PendingRestore}" Background="{StaticResource WarningSoft}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="4" Padding="14">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Classes="body" VerticalAlignment="Center" Margin="0,0,12,0" Text="{Binding L[msg.restoreWarning]}" />
                        <Button Grid.Column="1" Margin="0,0,8,0" Command="{Binding CancelRestoreCommand}" Content="{Binding L[btn.cancel]}" />
                        <Button Grid.Column="2" Classes="primary" Command="{Binding ConfirmRestoreCommand}" Content="{Binding L[btn.confirmRestore]}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
