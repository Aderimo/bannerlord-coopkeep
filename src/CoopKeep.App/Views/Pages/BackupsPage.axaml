<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             xmlns:saves="using:CoopKeep.Core.Saves"
             x:Class="CoopKeep.App.Views.Pages.BackupsPage"
             x:DataType="vm:MainViewModel">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="36,28,36,40" Spacing="18" MaxWidth="1000">

        <Grid Classes="enter" ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="{Binding L[nav.backups]}" />
                <TextBlock Classes="display" Text="{Binding L[backups.title]}" />
                <TextBlock Classes="dim" FontSize="13.5" TextWrapping="Wrap">
                    <Run Text="{Binding L[backups.for]}" />
                    <Run Text="{Binding SelectedCampaign.Name, FallbackValue='—'}" FontWeight="SemiBold"
                         Foreground="{StaticResource TextMain}" />
                </TextBlock>
            </StackPanel>
            <Button Grid.Column="1" Classes="primary" VerticalAlignment="Center" Command="{Binding BackupNowCommand}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="icon" Data="{StaticResource IconArchive}" />
                    <TextBlock Text="{Binding L[btn.backupNow]}" />
                </StackPanel>
            </Button>
        </Grid>

        <Border Classes="card enter d1">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h2" Text="{Binding L[lbl.autoBackup]}" />
                    <TextBlock Classes="hint" Text="{Binding L[msg.backupHint]}" />
                </StackPanel>
                <ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoBackup}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <Border Classes="card enter d2">
            <StackPanel Spacing="12">
                <TextBlock Classes="h2" Text="{Binding L[backups.list]}" />
                <TextBlock Classes="hint" Text="{Binding L[msg.noBackups]}" IsVisible="{Binding !HasBackups}" />

                <ListBox ItemsSource="{Binding Backups}" SelectedItem="{Binding SelectedBackup}" MaxHeight="360"
                         IsVisible="{Binding HasBackups}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="saves:BackupEntry">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <Path Data="{StaticResource IconArchive}" Stroke="{StaticResource TextDim}" StrokeThickness="1.6"
                                      Width="16" Height="16" Stretch="Uniform" />
                                <TextBlock Grid.Column="1" Margin="12,0" FontSize="13" VerticalAlignment="Center"
                                           Text="{Binding CreatedLocal, StringFormat='{}{0:dd MMMM yyyy  HH:mm:ss}'}" />
                                <TextBlock Grid.Column="2" Classes="dim" VerticalAlignment="Center"
                                           Text="{Binding SizeBytes, Converter={x:Static vm:Formatters.FileSize}}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding !PendingRestore}">
                    <TextBlock Classes="hint" VerticalAlignment="Center" Text="{Binding L[msg.stopToRestore]}"
                               IsVisible="{Binding IsRunning}" />
                    <Button Grid.Column="1" Command="{Binding RequestRestoreCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7">
                            <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="14" />
                            <TextBlock Text="{Binding L[btn.restore]}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <Border Classes="enter" IsVisible="{Binding PendingRestore}" Background="{StaticResource WarningSoft}"
                        BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="10" Padding="14">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBlock Classes="body" VerticalAlignment="Center" Margin="0,0,12,0"
                                   Text="{Binding L[msg.restoreWarning]}" />
                        <Button Grid.Column="1" Margin="0,0,8,0" Command="{Binding CancelRestoreCommand}"
                                Content="{Binding L[btn.cancel]}" />
                        <Button Grid.Column="2" Classes="primary" Command="{Binding ConfirmRestoreCommand}"
                                Content="{Binding L[btn.confirmRestore]}" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
