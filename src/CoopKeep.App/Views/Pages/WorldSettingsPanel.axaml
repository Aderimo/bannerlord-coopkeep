<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             xmlns:pages="using:CoopKeep.App.Views.Pages"
             x:Class="CoopKeep.App.Views.Pages.WorldSettingsPanel"
             x:DataType="vm:WorldSettingsEditor">

    <!--
        Bir dünyanın oyun ayarları formu. Hem sihirbazda hem Dünyalar sayfasında
        aynı kontrol kullanılır. ShowDifficulty / ShowRules hangi bölümlerin
        görüneceğini seçer (sihirbaz bunları ayrı adımlarda gösterir).
    -->
    <UserControl.Resources>
        <!-- Ayar satırı şablonu: başlık + açıklama + kontrol -->
        <DataTemplate x:Key="SettingRow" x:DataType="vm:WorldSettingItem">
            <Border Padding="0,9" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center"
                                Background="Transparent" ToolTip.Tip="{Binding Description}">
                        <TextBlock Text="{Binding Title}" FontSize="13.5" FontWeight="SemiBold"
                                   Foreground="{StaticResource TextMain}" VerticalAlignment="Center" />
                        <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6"
                              Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Açık / kapalı -->
                    <ToggleSwitch Grid.Column="1" IsChecked="{Binding BoolValue}" IsVisible="{Binding IsBool}"
                                  VerticalAlignment="Center" />

                    <!-- Sayı: kaydırıcı + değer -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" IsVisible="{Binding IsNumber}"
                                VerticalAlignment="Center">
                        <Slider Width="200" Minimum="{Binding Minimum}" Maximum="{Binding Maximum}"
                                Value="{Binding NumberValue}" SmallChange="{Binding Step}" LargeChange="{Binding Step}"
                                TickFrequency="{Binding Step}" IsSnapToTickEnabled="True" />
                        <Border Classes="valuebar">
                            <TextBlock Text="{Binding NumberText}" FontWeight="SemiBold" FontSize="12.5"
                                       HorizontalAlignment="Center" />
                        </Border>
                    </StackPanel>

                    <!-- Seviye / seçim: yan yana düğmeler + seçilen etkinin açıklaması -->
                    <StackPanel Grid.Column="1" Spacing="6" IsVisible="{Binding HasOptions}" VerticalAlignment="Center"
                                HorizontalAlignment="Right">
                        <ItemsControl ItemsSource="{Binding Options}" HorizontalAlignment="Right">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="4" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SettingOption">
                                    <RadioButton Classes="seg" GroupName="{Binding Group}" IsChecked="{Binding IsSelected}"
                                                 Content="{Binding Label}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding ChoiceEffect}" FontSize="11.5" Foreground="{StaticResource Accent}"
                                   HorizontalAlignment="Right" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <UserControl.Styles>
        <!-- Segment düğmesi: oyunun seviye seçicisine benzer -->
        <Style Selector="RadioButton.seg">
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Name="bg" Background="{StaticResource BgRaised}" BorderBrush="{StaticResource BorderDim}"
                            BorderThickness="1" CornerRadius="7" Padding="11,6" Cursor="Hand">
                        <Border.Transitions>
                            <Transitions>
                                <BrushTransition Property="Background" Duration="0:0:0.16" />
                                <BrushTransition Property="BorderBrush" Duration="0:0:0.16" />
                            </Transitions>
                        </Border.Transitions>
                        <ContentPresenter Name="cp" Content="{TemplateBinding Content}" FontSize="12"
                                          Foreground="{StaticResource TextDim}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="RadioButton.seg:pointerover /template/ Border#bg">
            <Setter Property="BorderBrush" Value="#454B58" />
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ Border#bg">
            <Setter Property="Background" Value="{StaticResource AccentSoft}" />
            <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
        </Style>
        <Style Selector="RadioButton.seg:checked /template/ ContentPresenter#cp">
            <Setter Property="Foreground" Value="{StaticResource Accent}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="Expander">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="22">

        <!-- ================= ZORLUK ================= -->
        <StackPanel Spacing="14" IsVisible="{Binding $parent[pages:WorldSettingsPanel].ShowDifficulty}">
            <StackPanel Spacing="3">
                <TextBlock Classes="h2" Text="{Binding L[grp.difficulty]}" />
                <TextBlock Classes="hint" Text="{Binding L[grp.difficulty.desc]}" />
            </StackPanel>

            <!-- Ön ayar kartları -->
            <UniformGrid Columns="3">
                <RadioButton Classes="choice" GroupName="{Binding $parent[pages:WorldSettingsPanel].PresetGroup}"
                             IsChecked="{Binding PresetVeryEasy}" Margin="0,0,6,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[preset.VeryEasy]}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Classes="hint" Text="{Binding L[preset.VeryEasy.desc]}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Classes="choice" GroupName="{Binding $parent[pages:WorldSettingsPanel].PresetGroup}"
                             IsChecked="{Binding PresetEasy}" Margin="3,0,3,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[preset.Easy]}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Classes="hint" Text="{Binding L[preset.Easy.desc]}" />
                    </StackPanel>
                </RadioButton>
                <RadioButton Classes="choice" GroupName="{Binding $parent[pages:WorldSettingsPanel].PresetGroup}"
                             IsChecked="{Binding PresetRealistic}" Margin="6,0,0,0">
                    <StackPanel Spacing="5">
                        <TextBlock Text="{Binding L[preset.Realistic]}" FontWeight="SemiBold" FontSize="14" />
                        <TextBlock Classes="hint" Text="{Binding L[preset.Realistic.desc]}" />
                    </StackPanel>
                </RadioButton>
            </UniformGrid>

            <Border Classes="badge" HorizontalAlignment="Left" Background="{StaticResource BgRaised}"
                    IsVisible="{Binding PresetCustom}">
                <TextBlock FontSize="12" Foreground="{StaticResource TextDim}" Text="{Binding L[preset.Custom.desc]}" />
            </Border>

            <ToggleButton Classes="disclosure" HorizontalAlignment="Left"
                          IsChecked="{Binding $parent[pages:WorldSettingsPanel].ExpandDetails, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Path Classes="chevron" Data="M9,6 L15,12 L9,18" Stroke="{StaticResource Accent}" StrokeThickness="2"
                          Width="12" Height="12" Stretch="Uniform" StrokeLineCap="Round" StrokeJoin="Round" />
                    <TextBlock Text="{Binding L[wiz.customize]}" FontSize="13" Foreground="{StaticResource Accent}" />
                </StackPanel>
            </ToggleButton>
            <ItemsControl Classes="enter" ItemsSource="{Binding DifficultyItems}" ItemTemplate="{StaticResource SettingRow}"
                          IsVisible="{Binding $parent[pages:WorldSettingsPanel].ExpandDetails}" />
        </StackPanel>

        <!-- ================= KURALLAR ================= -->
        <StackPanel Spacing="22" IsVisible="{Binding $parent[pages:WorldSettingsPanel].ShowRules}">
            <StackPanel>
                <TextBlock Classes="h2" Text="{Binding L[grp.life]}" />
                <ItemsControl ItemsSource="{Binding LifeItems}" ItemTemplate="{StaticResource SettingRow}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="h2" Text="{Binding L[grp.world]}" />
                <ItemsControl ItemsSource="{Binding WorldItems}" ItemTemplate="{StaticResource SettingRow}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="h2" Text="{Binding L[grp.multiplayer]}" />
                <ItemsControl ItemsSource="{Binding MultiplayerItems}" ItemTemplate="{StaticResource SettingRow}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Classes="h2" Text="{Binding L[grp.cheats]}" />
                <ItemsControl ItemsSource="{Binding CheatItems}" ItemTemplate="{StaticResource SettingRow}" />
            </StackPanel>
        </StackPanel>
    </StackPanel>
</UserControl>
