<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             x:Class="CoopKeep.App.Views.Pages.ConsolePage"
             x:DataType="vm:MainViewModel">

  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="32,28,32,24">
    <Grid Classes="enter" ColumnDefinitions="*,Auto">
        <TextBlock Classes="display" Text="{Binding L[nav.console]}" ToolTip.Tip="{Binding L[console.sub]}" />
        <Button Grid.Column="1" VerticalAlignment="Center" Command="{Binding OpenLogsFolderCommand}">
            <StackPanel Orientation="Horizontal" Spacing="7">
                <Path Classes="icon" Data="{StaticResource IconFolder}" Width="14" />
                <TextBlock Text="{Binding L[btn.openLogs]}" />
            </StackPanel>
        </Button>
    </Grid>

    <!-- Bu oturumda görülen tanıdık satırlar -->
    <Border Grid.Row="1" Classes="card enter d1" Margin="0,14,0,0" Padding="14,10" IsVisible="{Binding HasSeenLogLines}">
        <StackPanel Spacing="6">
            <TextBlock Classes="h2" FontSize="14" Text="{Binding L[console.known]}" />
            <ItemsControl ItemsSource="{Binding SeenLogLines}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SeenLogLine">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" Margin="0,3">
                            <Panel Width="16" VerticalAlignment="Top" Margin="0,2,8,0">
                                <Path Data="{StaticResource IconWarn}" Stroke="{StaticResource Danger}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" IsVisible="{Binding IsError}" />
                                <Path Data="{StaticResource IconWarn}" Stroke="{StaticResource Warning}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" IsVisible="{Binding IsWarning}" />
                                <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextDim}" StrokeThickness="1.8" Width="13" Height="13" Stretch="Uniform" IsVisible="{Binding IsHarmless}" />
                            </Panel>
                            <TextBlock Grid.Column="1" FontWeight="SemiBold" FontSize="12.5" Margin="0,0,10,0" Text="{Binding Title}" />
                            <TextBlock Grid.Column="2" Classes="hint" Text="{Binding Explanation}" />
                            <TextBlock Grid.Column="3" Classes="dim" FontSize="11" Margin="10,0,0,0"><Run Text="×" /><Run Text="{Binding Count}" /></TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>

    <!-- Arama ve süzgeç -->
    <Grid Grid.Row="2" Classes="enter d1" ColumnDefinitions="300,*,Auto" Margin="0,14,0,10">
        <TextBox Text="{Binding ConsoleSearch}" Watermark="{Binding L[console.search]}" />
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Classes="dim" Text="{Binding L[console.problemsOnly]}" VerticalAlignment="Center" />
            <ToggleSwitch IsChecked="{Binding ConsoleProblemsOnly}" />
        </StackPanel>
    </Grid>

    <Border Grid.Row="3" Classes="enter d2" Background="{StaticResource ConsoleBg}" CornerRadius="4"
            BorderBrush="{StaticResource BorderDim}" BorderThickness="1" Padding="14" ClipToBounds="True">
        <Panel>
            <!--
                Gizli modda bulanıklaştırılır: konsol dosya yolları (kullanıcı adı dahil),
                oyuncu adresleri ve Steam lobi kimliği içeriyor — yayında görünmemeli.
            -->
            <ScrollViewer Name="ConsoleScroll" Effect="{Binding ConsoleEffect}"
                          HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding ConsoleView}">
                    <!-- Sanallaştırma: 2000 satırın hepsi ekranda çizilmesin. -->
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <VirtualizingStackPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <SelectableTextBlock Text="{Binding}" FontFamily="Cascadia Mono, Consolas, monospace"
                                                 FontSize="11.5" Foreground="#BFB39A" TextWrapping="NoWrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <Border IsVisible="{Binding PrivacyMode}" Background="#B00E0B08" CornerRadius="4">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10">
                    <Path Data="{StaticResource IconEye}" Stroke="{StaticResource TextDim}" StrokeThickness="1.5"
                          Width="32" Height="32" Stretch="Uniform" />
                    <TextBlock Text="{Binding L[msg.consoleHidden]}" Classes="hint" TextAlignment="Center" MaxWidth="340" />
                </StackPanel>
            </Border>
        </Panel>
    </Border>

    <!-- Elle komut: sunucu sahibi kendi sunucusuna yazar ("help" komut listesini verir). -->
    <Grid Grid.Row="4" ColumnDefinitions="*,Auto" Margin="0,10,0,0">
        <TextBox Text="{Binding ConsoleInput}" Watermark="{Binding L[console.inputHint]}"
                 FontFamily="Cascadia Mono, Consolas, monospace" FontSize="12"
                 IsEnabled="{Binding IsRunning}">
            <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding SendConsoleInputCommand}" />
                <KeyBinding Gesture="Up" Command="{Binding PreviousConsoleInputCommand}" />
            </TextBox.KeyBindings>
        </TextBox>
        <Button Grid.Column="1" Margin="8,0,0,0" Command="{Binding SendConsoleInputCommand}"
                Content="{Binding L[console.send]}" />
    </Grid>
  </Grid>
</UserControl>
