<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             xmlns:proto="using:CoopKeep.Core.Protocol"
             x:Class="CoopKeep.App.Views.Pages.PlayersPage"
             x:DataType="vm:MainViewModel">

  <!--
      Oyuncular: kim bağlı, kim kayıtlı, at / banla / ban kaldır / geri al.
      Hile ve yönetici araçları ayrı "Hileler" sekmesinde.
  -->
  <UserControl.Styles>
    <Style Selector="Button.row">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Background" Value="{StaticResource BgRaised}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.row:pointerover /template/ ContentPresenter">
        <Setter Property="BorderBrush" Value="{StaticResource AccentDim}" />
        <Setter Property="Background" Value="{StaticResource BgRaised}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,40" Spacing="16" MaxWidth="1080">

        <TextBlock Classes="display enter" Text="{Binding L[nav.players]}" />

        <!-- Son işlem + geri al -->
        <Border Classes="card enter" Padding="14,10" IsVisible="{Binding CanUndoPlayerAction}"
                Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentDim}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource Accent}" StrokeThickness="1.8"
                      Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Text="{Binding LastPlayerAction}" />
                <Button Grid.Column="2" Command="{Binding UndoPlayerActionCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Path Classes="icon" Data="{StaticResource IconArrowLeft}" Width="12" />
                        <TextBlock Text="{Binding L[btn.undo]}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!-- Sunucu kapalı -->
        <Border Classes="card enter d1" IsVisible="{Binding !IsServing}" Padding="16,12">
            <StackPanel Orientation="Horizontal" Spacing="10">
                <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextDim}" StrokeThickness="1.8"
                      Width="16" Height="16" Stretch="Uniform" />
                <TextBlock Classes="body" Text="{Binding L[players.offline]}" VerticalAlignment="Center" />
            </StackPanel>
        </Border>

        <Grid ColumnDefinitions="*,16,*">

          <!-- ============ SOL: BAĞLI + KAYITLI ============ -->
          <StackPanel Grid.Column="0" Spacing="16">
            <Border Classes="card enter d1" IsVisible="{Binding IsServing}">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,Auto,*">
                        <TextBlock Classes="h2" Text="{Binding L[players.online]}" VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="badge" Background="{StaticResource SuccessSoft}" Margin="10,0,0,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="{Binding OnlinePlayerCount}" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{StaticResource Success}" />
                        </Border>
                        <TextBox Grid.Column="2" MaxWidth="180" HorizontalAlignment="Right" Text="{Binding PlayerFilter}"
                                 Watermark="{Binding L[msg.searchPlayers]}" />
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Players}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="proto:ConnectedPlayer">
                                <Border Classes="enter" Padding="10,8" CornerRadius="4" Background="{StaticResource BgRaised}" Margin="0,0,0,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                        <Border Classes="pulse" Width="8" Height="8" CornerRadius="4" Background="{StaticResource Success}"
                                                VerticalAlignment="Center" Margin="0,0,10,0" />
                                        <Button Grid.Column="1" Classes="ghost" Padding="0" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                                ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[profile.open]}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenProfileCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel VerticalAlignment="Center" Spacing="1">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Classes="dim" FontSize="11"><Run Text="#" /><Run Text="{Binding Id}" /><Run Text=" · " /><Run Text="{Binding State}" /></TextBlock>
                                            </StackPanel>
                                        </Button>
                                        <Button Grid.Column="2" Margin="0,0,6,0" Padding="10,5"
                                                ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[players.kickTip]}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).KickCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[btn.kick]}" />
                                        <Button Grid.Column="3" Classes="danger" Padding="10,5"
                                                ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[players.banTip]}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).BlockPlayerCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="icon" Data="{StaticResource IconBan}" Width="12" />
                                                <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[btn.ban]}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Classes="dim" Text="{Binding L[msg.noPlayers]}" IsVisible="{Binding !HasPlayers}" />

                    <Grid ColumnDefinitions="*,6,Auto">
                        <TextBox Text="{Binding AnnounceText}" Watermark="{Binding L[msg.announcePlaceholder]}" />
                        <Button Grid.Column="2" Command="{Binding AnnounceCommand}" ToolTip.Tip="{Binding L[btn.announce]}">
                            <Path Classes="icon" Data="{StaticResource IconMegaphone}" Width="15" />
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Kayıtlı karakterler -->
            <Border Classes="card enter d2">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="Auto,*,6,Auto">
                        <TextBlock Classes="h2" Text="{Binding L[heroes.title]}" ToolTip.Tip="{Binding L[heroes.sub]}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Width="200" Margin="12,0,0,0" HorizontalAlignment="Right" Text="{Binding HeroFilter}"
                                 Watermark="{Binding L[heroes.search]}" />
                        <Button Grid.Column="3" Padding="8,5" Command="{Binding RefreshHeroesCommand}" ToolTip.Tip="{Binding L[btn.refresh]}">
                            <Path Classes="icon" Data="{StaticResource IconRefresh}" Width="14" />
                        </Button>
                    </Grid>
                    <TextBlock Classes="hint" Text="{Binding L[heroes.empty]}" IsVisible="{Binding !HasHeroes}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding VisibleHeroes}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:HeroRow">
                                <Button Classes="row" Padding="10,8" Margin="0,0,0,6"
                                        ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[profile.open]}"
                                        Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenProfileCommand}"
                                        CommandParameter="{Binding}">
                                    <Grid ColumnDefinitions="Auto,*,Auto">
                                        <Panel Width="34" Height="34">
                                            <Border CornerRadius="17" Background="{StaticResource AccentSoft}"
                                                    BorderBrush="{StaticResource AccentDim}" BorderThickness="1">
                                                <TextBlock Text="{Binding Initial}" FontWeight="Bold" Foreground="{StaticResource Accent}"
                                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{StaticResource Success}"
                                                    BorderBrush="{StaticResource BgRaised}" BorderThickness="2"
                                                    HorizontalAlignment="Right" VerticalAlignment="Bottom" IsVisible="{Binding IsOnline}" />
                                        </Panel>
                                        <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center" Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border Classes="badge" Background="{StaticResource DangerSoft}" Padding="6,0" IsVisible="{Binding IsBanned}">
                                                    <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[players.banned]}"
                                                               FontSize="10.5" Foreground="{StaticResource Danger}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis">
                                                <Run Text="{Binding SteamIdShort}" /><Run Text="  ·  " /><Run Text="{Binding StatText}" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="danger" Padding="10,5" VerticalAlignment="Center"
                                                IsVisible="{Binding !IsBanned}"
                                                ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[players.banTip]}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).BanHeroCommand}"
                                                CommandParameter="{Binding}">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <Path Classes="icon" Data="{StaticResource IconBan}" Width="12" />
                                                <TextBlock Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[btn.ban]}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
          </StackPanel>

          <!-- ============ SAĞ: BANLILAR ============ -->
          <StackPanel Grid.Column="2" Spacing="16">
            <Border Classes="card enter d1">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h2" Text="{Binding L[bans.title]}" ToolTip.Tip="{Binding L[bans.tip]}" />
                        <Path Grid.Column="1" Data="{StaticResource IconBan}" Stroke="{StaticResource Danger}"
                              StrokeThickness="1.6" Width="15" Height="15" Stretch="Uniform" />
                    </Grid>
                    <TextBlock Classes="hint" Text="{Binding L[bans.empty]}" IsVisible="{Binding !HasBans}" TextWrapping="Wrap" />
                    <ItemsControl ItemsSource="{Binding Bans}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:BanRow">
                                <Border Padding="10,8" CornerRadius="4" Background="{StaticResource BgRaised}" Margin="0,0,0,6"
                                        BorderBrush="{StaticResource DangerSoft}" BorderThickness="1">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <Border Classes="badge" Background="{StaticResource WarningSoft}" Padding="6,0" IsVisible="{Binding IsByName}"
                                                        ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[bans.byNameTip]}">
                                                    <TextBlock FontSize="10.5" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[bans.byName]}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Classes="dim" FontSize="11.5" IsVisible="{Binding !IsByName}"><Run Text="{Binding SteamIdShort}" /><Run Text="  ·  " /><Run Text="{Binding DateText}" /></TextBlock>
                                            <TextBlock Classes="dim" FontSize="11.5" FontStyle="Italic" Text="{Binding Note}" IsVisible="{Binding HasNote}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button Grid.Column="1" VerticalAlignment="Center"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).UnbanCommand}"
                                                CommandParameter="{Binding}"
                                                Content="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[btn.unban]}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox Text="{Binding AdminNote}" Watermark="{Binding L[bans.note]}" />
                </StackPanel>
            </Border>

          </StackPanel>
        </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
