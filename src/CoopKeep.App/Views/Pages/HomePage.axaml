<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             xmlns:proto="using:CoopKeep.Core.Protocol"
             x:Class="CoopKeep.App.Views.Pages.HomePage"
             x:DataType="vm:MainViewModel">

  <UserControl.Resources>
    <!-- Kurulum / açılış denetimi satırı: simge, metin, düzeltme düğmesi -->
    <DataTemplate x:Key="CheckRowTemplate" x:DataType="vm:CheckRow">
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4">
            <Panel Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top">
                <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource Success}" StrokeThickness="2.2" Stretch="Uniform" IsVisible="{Binding IsOk}" />
                <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextDim}" StrokeThickness="1.8" Stretch="Uniform" IsVisible="{Binding IsInfo}" />
                <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource Accent}" StrokeThickness="2" Stretch="Uniform" IsVisible="{Binding IsWarning}" />
                <Path Data="{StaticResource IconClose}" Stroke="{StaticResource Danger}" StrokeThickness="2.2" Stretch="Uniform" IsVisible="{Binding IsError}" />
            </Panel>
            <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" VerticalAlignment="Center" Text="{Binding Text}" />
            <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" IsVisible="{Binding HasFix}"
                    Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCheckFixCommand}"
                    CommandParameter="{Binding Fix}" Content="{Binding FixLabel}" />
        </Grid>
    </DataTemplate>
  </UserControl.Resources>

  <UserControl.Styles>
    <Style Selector="Border.jstep">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{StaticResource BgRaised}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderDim}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.jstep.active">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="Border.jstep.done">
        <Setter Property="Background" Value="{StaticResource Success}" />
        <Setter Property="BorderBrush" Value="{StaticResource Success}" />
    </Style>
    <Style Selector="TextBlock.jlabel">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{StaticResource TextDim}" />
    </Style>
    <Style Selector="TextBlock.jlabel.active">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Border.jline">
        <Setter Property="Background" Value="{StaticResource BorderDim}" />
    </Style>
    <Style Selector="Border.jline.done">
        <Setter Property="Background" Value="{StaticResource Success}" />
    </Style>

    <!-- Durum şeridindeki küçük bilgi hücresi -->
    <Style Selector="StackPanel.fact > TextBlock.k">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Foreground" Value="{StaticResource TextFaint}" />
    </Style>
    <Style Selector="StackPanel.fact > TextBlock.v">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource TextMain}" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,36" Spacing="16" MaxWidth="1080">

        <StackPanel Classes="enter" Spacing="2">
            <TextBlock Classes="display" Text="{Binding HeroTitle}" />
            <TextBlock Classes="dim" FontSize="13.5" Text="{Binding HeroSubtitle}" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Yolculuk: Kurulum → Dünya → Sunucu → Arkadaşlar -->
        <Grid ColumnDefinitions="Auto,*,Auto,*,Auto,*,Auto" Classes="enter" Margin="0,4,0,4">
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Panel Width="22" Height="22">
                    <Border Classes="jstep" Classes.done="{Binding JourneySetupDone}" Classes.active="{Binding JourneySetupActive}" />
                    <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccent}" StrokeThickness="2.4" Width="10" Height="10" Stretch="Uniform" IsVisible="{Binding JourneySetupDone}" />
                    <TextBlock Text="1" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !JourneySetupDone}" />
                </Panel>
                <TextBlock Classes="jlabel" Classes.active="{Binding JourneySetupActive}" VerticalAlignment="Center" Text="{Binding L[journey.setup]}" />
            </StackPanel>
            <Border Grid.Column="1" Height="2" Margin="10,0" VerticalAlignment="Center" Classes="jline" Classes.done="{Binding JourneySetupDone}" />
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Panel Width="22" Height="22">
                    <Border Classes="jstep" Classes.done="{Binding JourneyWorldDone}" Classes.active="{Binding JourneyWorldActive}" />
                    <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccent}" StrokeThickness="2.4" Width="10" Height="10" Stretch="Uniform" IsVisible="{Binding JourneyWorldDone}" />
                    <TextBlock Text="2" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !JourneyWorldDone}" />
                </Panel>
                <TextBlock Classes="jlabel" Classes.active="{Binding JourneyWorldActive}" VerticalAlignment="Center" Text="{Binding L[journey.world]}" />
            </StackPanel>
            <Border Grid.Column="3" Height="2" Margin="10,0" VerticalAlignment="Center" Classes="jline" Classes.done="{Binding JourneyWorldDone}" />
            <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="8">
                <Panel Width="22" Height="22">
                    <Border Classes="jstep" Classes.done="{Binding JourneyServerDone}" Classes.active="{Binding JourneyServerActive}" />
                    <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccent}" StrokeThickness="2.4" Width="10" Height="10" Stretch="Uniform" IsVisible="{Binding JourneyServerDone}" />
                    <TextBlock Text="3" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !JourneyServerDone}" />
                </Panel>
                <TextBlock Classes="jlabel" Classes.active="{Binding JourneyServerActive}" VerticalAlignment="Center" Text="{Binding L[journey.server]}" />
            </StackPanel>
            <Border Grid.Column="5" Height="2" Margin="10,0" VerticalAlignment="Center" Classes="jline" Classes.done="{Binding JourneyServerDone}" />
            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="8">
                <Panel Width="22" Height="22">
                    <Border Classes="jstep" Classes.done="{Binding JourneyFriendsDone}" Classes.active="{Binding JourneyFriendsActive}" />
                    <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccent}" StrokeThickness="2.4" Width="10" Height="10" Stretch="Uniform" IsVisible="{Binding JourneyFriendsDone}" />
                    <TextBlock Text="4" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !JourneyFriendsDone}" />
                </Panel>
                <TextBlock Classes="jlabel" Classes.active="{Binding JourneyFriendsActive}" VerticalAlignment="Center" Text="{Binding L[journey.friends]}" />
            </StackPanel>
        </Grid>

        <!-- ============ ANA KART ============ -->
        <Border Classes="card enter d1" Background="{StaticResource HeroGradient}" Padding="26,22">
            <Panel>

                <!-- Kurulum eksik: adım adım denetim, her eksikte tek düğmeli düzeltme -->
                <StackPanel Spacing="10" IsVisible="{Binding HomeSetup}">
                    <TextBlock Classes="h1" Text="{Binding L[home.setup.head]}" />
                    <ItemsControl ItemsSource="{Binding SetupChecks}" ItemTemplate="{StaticResource CheckRowTemplate}" />
                    <StackPanel Orientation="Horizontal" Spacing="10">
                        <Button Command="{Binding RefreshCommand}" Content="{Binding L[home.setup.recheck]}" />
                        <Button Classes="ghost" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Guide}"
                                Content="{Binding L[home.setup.guide]}" />
                    </StackPanel>
                </StackPanel>

                <!-- Dünya yok -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HomeNoWorld}">
                    <TextBlock Classes="h1" Text="{Binding L[home.noworld.head]}" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="primary big" Command="{Binding OpenWizardCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <Path Classes="icon" Data="{StaticResource IconPlus}" StrokeThickness="2.2" />
                            <TextBlock Text="{Binding L[home.noworld.cta]}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Hazır -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HomeReady}">
                    <StackPanel Spacing="10" VerticalAlignment="Center">
                        <TextBlock Classes="h1" Text="{Binding SelectedCampaign.Name, FallbackValue=''}" />
                        <ItemsControl ItemsSource="{Binding WorldEditor.SummaryParts}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="badge" Background="{StaticResource AccentSoft}" Margin="0,0,6,6"
                                            BorderBrush="{StaticResource AccentDim}" BorderThickness="1">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource Accent}" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Spacing="14">
                            <Button Classes="ghost" Padding="0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Worlds}">
                                <TextBlock Text="{Binding L[home.ready.edit]}" Foreground="{StaticResource Accent}" FontSize="12.5" />
                            </Button>
                            <Button Classes="ghost" Padding="0" Command="{Binding OpenWizardCommand}">
                                <TextBlock Text="{Binding L[home.ready.another]}" Foreground="{StaticResource TextDim}" FontSize="12.5" />
                            </Button>
                        </StackPanel>
                    </StackPanel>
                    <!-- Önce sunucu (Coop'un sunucusu ayrı ve penceresiz çalışır); açılınca "Oyuna gir". -->
                    <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center">
                        <Button Classes="primary big" Command="{Binding StartCommand}" ToolTip.Tip="{Binding L[btn.startServer.tip]}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Data="{StaticResource IconPlay}" Fill="{StaticResource OnAccent}" Width="14" Height="14" Stretch="Uniform" />
                                <TextBlock Text="{Binding L[btn.startServer]}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="ghost" Padding="0" HorizontalAlignment="Center" Command="{Binding StartPlayingCommand}"
                                ToolTip.Tip="{Binding L[btn.startAndPlay.tip]}">
                            <TextBlock FontSize="12.5" Foreground="{StaticResource TextDim}" Text="{Binding L[btn.startAndPlay]}" />
                        </Button>
                    </StackPanel>
                </Grid>

                <!-- Açılıyor -->
                <StackPanel Spacing="16" IsVisible="{Binding HomeStarting}">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Classes="spin" Data="M12,2 A10,10 0 0 1 22,12" Stroke="{StaticResource Accent}"
                              StrokeThickness="2.6" StrokeLineCap="Round" Width="24" Height="24" Stretch="None"
                              RenderTransformOrigin="50%,50%" />
                        <TextBlock Grid.Column="1" Margin="12,0" Classes="h2" VerticalAlignment="Center" Text="{Binding StatusText}" />
                        <Button Grid.Column="2" Classes="danger" Command="{Binding StopCommand}" Content="{Binding L[btn.cancel]}" />
                    </Grid>
                    <ProgressBar Value="{Binding BootProgress}" Maximum="100" Height="6" />
                    <UniformGrid Columns="3">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Step1Brush}">
                                <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccent}" StrokeThickness="2.4" Width="9" Height="9" Stretch="Uniform" IsVisible="{Binding Step1Done}" />
                            </Border>
                            <TextBlock Classes="dim" Text="{Binding L[status.boot]}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Step2Brush}">
                                <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccent}" StrokeThickness="2.4" Width="9" Height="9" Stretch="Uniform" IsVisible="{Binding Step2Done}" />
                            </Border>
                            <TextBlock Classes="dim" Text="{Binding L[status.loading]}" VerticalAlignment="Center" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{Binding Step3Brush}">
                                <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource OnAccent}" StrokeThickness="2.4" Width="9" Height="9" Stretch="Uniform" IsVisible="{Binding Step3Done}" />
                            </Border>
                            <TextBlock Classes="dim" Text="{Binding L[status.serving]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </UniformGrid>
                </StackPanel>

                <!-- Yayında -->
                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HomeOnline}">
                    <StackPanel Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Panel Width="14" Height="14" VerticalAlignment="Center">
                                <Border Classes="pulse" Width="12" Height="12" CornerRadius="6" Background="{StaticResource Success}" RenderTransformOrigin="50%,50%" />
                                <Border Width="12" Height="12" CornerRadius="6" Background="{StaticResource Success}" />
                            </Panel>
                            <TextBlock Classes="h1" Text="{Binding ActiveSaveName}" />
                        </StackPanel>
                        <ItemsControl ItemsSource="{Binding WorldEditor.SummaryParts}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="x:String">
                                    <Border Classes="badge" Background="{StaticResource AccentSoft}" Margin="0,0,6,6"
                                            BorderBrush="{StaticResource AccentDim}" BorderThickness="1">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource Accent}" Text="{Binding}" />
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Center" MinWidth="190">
                        <Button Classes="primary" Command="{Binding JoinOwnServerCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="{Binding L[home.joinOwnTip]}" IsVisible="{Binding ShowJoinOwn}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{StaticResource IconPlay}" Width="12" />
                                <TextBlock Text="{Binding L[home.joinOwn]}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding SaveAndBackupCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="{Binding L[home.saveTip]}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{StaticResource IconSave}" />
                                <TextBlock Text="{Binding L[btn.saveAndBackup]}" />
                            </StackPanel>
                        </Button>
                        <Button Command="{Binding RestartWithCountdownCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                                ToolTip.Tip="{Binding L[settings.restartCountdownHint]}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{StaticResource IconRefresh}" />
                                <TextBlock Text="{Binding L[btn.restartCountdown]}" />
                            </StackPanel>
                        </Button>
                        <Button Classes="danger" Command="{Binding StopCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{StaticResource IconStop}" Width="12" Height="12" />
                                <TextBlock Text="{Binding L[btn.stopServer]}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Panel>
        </Border>

        <!-- ============ DURUM ŞERİDİ ============ -->
        <Border Classes="card enter d1" Padding="20,14">
            <UniformGrid Columns="6">
                <StackPanel Classes="fact" Spacing="2">
                    <TextBlock Classes="k" Text="{Binding L[home.stat.players]}" />
                    <TextBlock Classes="v" Text="{Binding OnlinePlayerCount}" />
                </StackPanel>
                <StackPanel Classes="fact" Spacing="2">
                    <TextBlock Classes="k" Text="{Binding L[home.stat.uptime]}" />
                    <TextBlock Classes="v" Text="{Binding Uptime}" />
                </StackPanel>
                <StackPanel Classes="fact" Spacing="2" ToolTip.Tip="{Binding L[msg.autosaveHint]}">
                    <TextBlock Classes="k" Text="{Binding L[home.stat.autosave]}" />
                    <TextBlock Classes="v" Text="{Binding AutosaveText}" />
                </StackPanel>
                <StackPanel Classes="fact" Spacing="2">
                    <TextBlock Classes="k" Text="{Binding L[home.stat.lastSave]}" />
                    <TextBlock Classes="v" Text="{Binding LastSaveText}" />
                </StackPanel>
                <StackPanel Classes="fact" Spacing="2">
                    <TextBlock Classes="k" Text="{Binding L[home.stat.lastBackup]}" />
                    <TextBlock Classes="v" Text="{Binding LastBackupText}" />
                </StackPanel>
                <StackPanel Classes="fact" Spacing="2" ToolTip.Tip="{Binding L[msg.ramHint]}">
                    <TextBlock Classes="k" Text="{Binding L[home.stat.resources]}" />
                    <TextBlock Classes="v"><Run Text="{Binding CpuText}" /><Run Text=" · " Foreground="{StaticResource TextFaint}" /><Run Text="{Binding RamText}" /></TextBlock>
                </StackPanel>
            </UniformGrid>
        </Border>

        <!-- Uyarılar -->
        <Border Classes="enter d2" Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1"
                CornerRadius="4" Padding="14,10" IsVisible="{Binding HasAlert}">
            <Grid ColumnDefinitions="Auto,*">
                <Path Data="{StaticResource IconWarn}" Stroke="{StaticResource Warning}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="body" Text="{Binding AlertText}" />
            </Grid>
        </Border>
        <Border Classes="enter d2" Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1"
                CornerRadius="4" Padding="14,10" IsVisible="{Binding HasMemoryWarning}">
            <Grid ColumnDefinitions="Auto,*">
                <Path Data="{StaticResource IconWarn}" Stroke="{StaticResource Warning}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Top" />
                <TextBlock Grid.Column="1" Margin="10,0,0,0" Classes="body" Text="{Binding MemoryWarning}" />
            </Grid>
        </Border>
        <!-- Kurulum tamam ama düzeltilecek bir şey var (DLC açık, engellenmiş dosyalar, güvenlik duvarı) -->
        <Border Classes="card enter d2" IsVisible="{Binding ShowSetupProblems}">
            <StackPanel Spacing="6">
                <TextBlock Classes="h2" Text="{Binding L[home.problems.head]}" />
                <ItemsControl ItemsSource="{Binding SetupChecks}" ItemTemplate="{StaticResource CheckRowTemplate}" />
            </StackPanel>
        </Border>

        <!-- Coop güncellendi: arkadaşlar da güncellemeli -->
        <Border Classes="enter d2" Background="{StaticResource AccentSoft}" BorderBrush="{StaticResource AccentDim}" BorderThickness="1"
                CornerRadius="4" Padding="14,10" IsVisible="{Binding HasCoopUpdatedNotice}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource Accent}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0" Classes="body" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding CoopUpdatedNotice}" />
                <Button Grid.Column="2" Padding="10,5" Command="{Binding DismissCoopUpdatedCommand}" Content="{Binding L[btn.ok]}" />
            </Grid>
        </Border>

        <Border Classes="enter d2" Background="{StaticResource WarningSoft}" BorderBrush="{StaticResource WarningBorder}" BorderThickness="1"
                CornerRadius="4" Padding="14,10" IsVisible="{Binding ShowModuleBanner}">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Path Data="{StaticResource IconPuzzle}" Stroke="{StaticResource Warning}" StrokeThickness="1.8" Width="16" Height="16" Stretch="Uniform" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Margin="10,0" Classes="body" VerticalAlignment="Center" TextWrapping="Wrap" Text="{Binding ModuleNotice}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Classes="primary" Padding="10,5" Command="{Binding MatchLauncherToWorldCommand}" Content="{Binding L[home.mods.match]}"
                            ToolTip.Tip="{Binding L[home.mods.matchTip]}" />
                    <Button Padding="10,5" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Mods}" Content="{Binding L[home.mods.fix]}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid ColumnDefinitions="*,16,*">
            <!-- ============ DAVET ============ -->
            <Border Classes="card enter d2">
                <StackPanel Spacing="12">
                    <TextBlock Classes="h2" Text="{Binding L[invite.title]}" ToolTip.Tip="{Binding L[invite.sub]}" />
                    <StackPanel Spacing="4">
                        <TextBlock Classes="dim" FontSize="11.5" Text="{Binding L[lbl.hostName]}" />
                        <Panel>
                            <TextBlock FontWeight="SemiBold" FontSize="18" Foreground="{StaticResource Accent}"
                                       FontFamily="{DynamicResource HeadingFont}" Text="{Binding DisplayedHostName}"
                                       IsVisible="{Binding SteamHostName, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            <TextBlock FontSize="12.5" Foreground="{StaticResource TextDim}" Text="{Binding HostNamePlaceholder}"
                                       IsVisible="{Binding SteamHostName, Converter={x:Static StringConverters.IsNullOrEmpty}}" />
                        </Panel>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Classes="dim" Text="{Binding L[lbl.password]}" Margin="0,0,14,4" />
                        <TextBlock Grid.Column="1" Classes="value" Text="{Binding PasswordText}" />
                        <TextBlock Grid.Row="1" Classes="dim" Text="{Binding L[lbl.modVersion]}" Margin="0,0,14,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="value" Text="{Binding ModVersion}" />
                        <TextBlock Grid.Row="2" Classes="dim" Text="{Binding L[lbl.directIp]}" Margin="0,0,14,0" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="value" Text="{Binding DisplayedEndpoint}" />
                    </Grid>
                    <WrapPanel>
                        <Button Classes="primary" Margin="0,0,8,8" Command="{Binding CopyConnectInfoCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Path Classes="icon" Data="{StaticResource IconCopy}" />
                                <TextBlock Text="{Binding L[invite.copy]}" />
                            </StackPanel>
                        </Button>
                        <Button Margin="0,0,8,8" Command="{Binding CreateInviteFileCommand}" ToolTip.Tip="{Binding L[invite.file.tip]}"
                                Content="{Binding L[invite.file.btn]}" />
                        <Button Margin="0,0,8,8" Command="{Binding OpenPortCommand}" ToolTip.Tip="{Binding L[upnp.tip]}"
                                Content="{Binding L[upnp.btn]}" />
                    </WrapPanel>
                    <CheckBox IsChecked="{Binding InviteIncludePassword}" Content="{Binding L[invite.file.password]}" FontSize="12" />
                </StackPanel>
            </Border>

            <!-- ============ BAĞLI OYUNCULAR ============ -->
            <Border Grid.Column="2" Classes="card enter d3">
                <StackPanel Spacing="10">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Classes="h2" Text="{Binding L[players.online]}" />
                        <Button Grid.Column="1" Classes="ghost" Padding="0" Command="{Binding NavigateCommand}" CommandParameter="{x:Static vm:AppPage.Players}">
                            <TextBlock Text="{Binding L[home.allPlayers]}" Foreground="{StaticResource Accent}" FontSize="12.5" />
                        </Button>
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Players}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="proto:ConnectedPlayer">
                                <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8" Classes="enter">
                                    <Border Width="28" Height="28" CornerRadius="14" Background="{StaticResource SuccessSoft}">
                                        <Path Data="{StaticResource IconUsers}" Stroke="{StaticResource Success}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" />
                                    </Border>
                                    <TextBlock Grid.Column="1" Margin="10,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{Binding Name}" />
                                    <TextBlock Grid.Column="2" Classes="dim" VerticalAlignment="Center" Text="{Binding State}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <StackPanel Spacing="4" IsVisible="{Binding !HasPlayers}">
                        <TextBlock Classes="dim" Text="{Binding L[msg.noPlayers]}" />
                        <TextBlock Classes="hint" FontSize="12" TextWrapping="Wrap" Text="{Binding L[empty.players]}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ============ ARKADAŞININ SUNUCUSUNA KATIL ============ -->
        <Border Classes="card enter d3">
            <StackPanel Spacing="12">
                <StackPanel Spacing="3">
                    <TextBlock Classes="h2" Text="{Binding L[coop.join.title]}" />
                    <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding L[coop.join.sub]}" />
                </StackPanel>
                <!-- Şifreyi Coop kendi menüsünde sorar; burada yalnızca adres. -->
                <Grid ColumnDefinitions="*,12,Auto" RowDefinitions="Auto,Auto" RowSpacing="4">
                    <TextBlock Classes="dim" FontSize="11.5" Text="{Binding L[coop.address]}" />
                    <TextBox Grid.Row="1" Text="{Binding CoopJoinAddress}" Watermark="203.0.113.5:4200"
                             PasswordChar="•" RevealPassword="{Binding !PrivacyMode}" />
                    <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding BrowseCoopCommand}" Content="{Binding L[coop.browse]}" />
                        <Button Classes="primary" Command="{Binding JoinCoopCommand}" Content="{Binding L[coop.join.start]}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
