<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             x:Class="CoopKeep.App.Views.Pages.ModsPage"
             x:DataType="vm:MainViewModel">

  <UserControl.Styles>
    <!-- Filtre sekmesi -->
    <Style Selector="RadioButton.tab">
        <Setter Property="Template">
            <ControlTemplate>
                <Border Name="bg" Background="Transparent" BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
                        CornerRadius="4" Padding="12,6" Cursor="Hand">
                    <Border.Transitions>
                        <Transitions>
                            <BrushTransition Property="Background" Duration="0:0:0.15" />
                            <BrushTransition Property="BorderBrush" Duration="0:0:0.15" />
                        </Transitions>
                    </Border.Transitions>
                    <ContentPresenter Name="cp" Content="{TemplateBinding Content}" FontSize="12.5"
                                      Foreground="{StaticResource TextDim}" />
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="RadioButton.tab:pointerover /template/ Border#bg">
        <Setter Property="BorderBrush" Value="#6A5535" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ Border#bg">
        <Setter Property="Background" Value="{StaticResource AccentSoft}" />
        <Setter Property="BorderBrush" Value="{StaticResource Accent}" />
    </Style>
    <Style Selector="RadioButton.tab:checked /template/ ContentPresenter#cp">
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
    </Style>
    <!-- Tıklanınca bilgi penceresini açan satır -->
    <Style Selector="Button.modRow">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Button.modRow:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{StaticResource BgRaised}" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.modRow:pressed">
        <Setter Property="RenderTransform" Value="scale(1)" />
    </Style>
    <!-- Sayfa düğmesi -->
    <Style Selector="Button.page">
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer Name="Scroller" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="32,28,32,40" Spacing="14" MaxWidth="1080">

        <TextBlock Classes="display enter" Text="{Binding L[nav.mods]}" />

        <!-- Özet -->
        <Border Classes="card enter d1" BorderBrush="{Binding ModsCardBorder}" Padding="18,14">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Border Width="38" Height="38" CornerRadius="19" Background="{Binding ModsIconBackground}">
                    <Panel>
                        <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource Success}" StrokeThickness="2.2"
                              Width="16" Height="16" Stretch="Uniform" IsVisible="{Binding !ModuleProblem}" />
                        <Path Data="{StaticResource IconWarn}" Stroke="{StaticResource Danger}" StrokeThickness="1.9"
                              Width="16" Height="16" Stretch="Uniform" IsVisible="{Binding ModuleProblem}" />
                    </Panel>
                </Border>
                <StackPanel Grid.Column="1" Margin="14,0" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Classes="h2" Text="{Binding ModsHeadline}" ToolTip.Tip="{Binding L[mods.why.body]}" />
                    <TextBlock Classes="dim" FontSize="12" Text="{Binding CommunityStatusText}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <Button Command="{Binding RestoreModProfileCommand}" Content="{Binding L[mods.restoreProfile]}"
                            IsVisible="{Binding HasProfileBackup}" />
                    <Button Classes="primary" Command="{Binding ApplyCoopProfileCommand}" Content="{Binding L[mods.applyProfile]}"
                            IsVisible="{Binding HasModuleProblems}" ToolTip.Tip="{Binding L[mods.profileHint]}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Arama ve filtreler -->
        <Grid Classes="enter d1" ColumnDefinitions="260,12,*">
            <TextBox Text="{Binding ModSearch}" Watermark="{Binding L[mods.search]}" VerticalAlignment="Top" />
            <WrapPanel Grid.Column="2" VerticalAlignment="Center">
                <RadioButton Classes="tab" GroupName="modsFilter" IsChecked="{Binding FilterAll}" Margin="0,0,6,6"
                             Content="{Binding L[mods.f.all]}" />
                <RadioButton Classes="tab" GroupName="modsFilter" IsChecked="{Binding FilterCompatible}" Margin="0,0,6,6">
                    <TextBlock><Run Text="{Binding L[mods.f.ok]}" /><Run Text=" " /><Run Text="{Binding CompatibleCount}" Foreground="{StaticResource TextFaint}" /></TextBlock>
                </RadioButton>
                <RadioButton Classes="tab" GroupName="modsFilter" IsChecked="{Binding FilterNotOnServer}" Margin="0,0,6,6">
                    <TextBlock><Run Text="{Binding L[mods.f.notOnServer]}" /><Run Text=" " /><Run Text="{Binding NotOnServerCount}" Foreground="{StaticResource TextFaint}" /></TextBlock>
                </RadioButton>
                <RadioButton Classes="tab" GroupName="modsFilter" IsChecked="{Binding FilterBlocked}" Margin="0,0,6,6">
                    <TextBlock><Run Text="{Binding L[mods.f.blocked]}" /><Run Text=" " /><Run Text="{Binding BlockedCount}" Foreground="{StaticResource TextFaint}" /></TextBlock>
                </RadioButton>
                <RadioButton Classes="tab" GroupName="modsFilter" IsChecked="{Binding FilterCommunityWorks}" Margin="0,0,6,6"
                             Content="{Binding L[mods.f.works]}" />
                <RadioButton Classes="tab" GroupName="modsFilter" IsChecked="{Binding FilterCommunityBroken}" Margin="0,0,6,6"
                             Content="{Binding L[mods.f.broken]}" />
                <RadioButton Classes="tab" GroupName="modsFilter" IsChecked="{Binding FilterLibrary}" Margin="0,0,6,6"
                             ToolTip.Tip="{Binding L[mods.f.libraryTip]}">
                    <TextBlock><Run Text="{Binding L[mods.f.library]}" /><Run Text=" " /><Run Text="{Binding LibraryCount}" Foreground="{StaticResource TextFaint}" /></TextBlock>
                </RadioButton>
            </WrapPanel>
        </Grid>

        <!-- Liste -->
        <Border Name="ListCard" Classes="card enter d2" Padding="6">
            <StackPanel>
                <Grid ColumnDefinitions="*,120,150,150,96" Margin="14,6,14,8">
                    <TextBlock Classes="dim" FontSize="11.5" Text="{Binding L[mods.col.module]}" />
                    <TextBlock Grid.Column="1" Classes="dim" FontSize="11.5" Text="{Binding L[mods.col.version]}" />
                    <TextBlock Grid.Column="2" Classes="dim" FontSize="11.5" Text="{Binding L[mods.col.status]}" />
                    <TextBlock Grid.Column="3" Classes="dim" FontSize="11.5" Text="{Binding L[mods.col.community]}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Modules}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:ModuleRow">
                          <Button Classes="modRow" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[mods.rowTip]}"
                                  Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenModInfoCommand}"
                                  CommandParameter="{Binding}">
                            <Border Padding="14,7" CornerRadius="4" Opacity="{Binding RowOpacity}">
                                <Border.Transitions>
                                    <Transitions><DoubleTransition Property="Opacity" Duration="0:0:0.2" /></Transitions>
                                </Border.Transitions>
                                <Grid ColumnDefinitions="Auto,*,120,150,150,96">
                                    <Panel Width="16" Margin="0,0,8,0" VerticalAlignment="Center">
                                        <Border Width="8" Height="8" CornerRadius="4" Background="{StaticResource Success}" IsVisible="{Binding IsSelected}" />
                                        <Border Width="8" Height="8" CornerRadius="4" BorderBrush="{StaticResource TextFaint}" BorderThickness="1.2" IsVisible="{Binding !IsSelected}" />
                                    </Panel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Id}" />
                                        <TextBlock Classes="dim" FontSize="11" Text="{Binding Category}" VerticalAlignment="Center" />
                                        <Button Classes="ghost" Padding="3" IsVisible="{Binding HasUrl}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).OpenModPageCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Classes="icon" Data="{StaticResource IconArrowRight}" Width="10" />
                                        </Button>
                                        <Border Classes="badge" Background="{StaticResource DangerSoft}" Padding="6,1" IsVisible="{Binding HadLocalError}"
                                                ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[mods.localErrorTip]}">
                                            <TextBlock FontSize="10.5" Foreground="{StaticResource Danger}"
                                                       Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[mods.localError]}" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" Classes="dim" Text="{Binding Version}" VerticalAlignment="Center" />
                                    <Panel Grid.Column="3" HorizontalAlignment="Left" VerticalAlignment="Center">
                                        <Border Classes="badge" Background="{StaticResource SuccessSoft}" IsVisible="{Binding IsOk}">
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Success}" Text="{Binding StatusText}" />
                                        </Border>
                                        <Border Classes="badge" Background="{StaticResource DangerSoft}" IsVisible="{Binding IsBlocked}">
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Danger}" Text="{Binding StatusText}" />
                                        </Border>
                                        <Border Classes="badge" Background="{StaticResource WarningSoft}" IsVisible="{Binding IsRisky}">
                                            <TextBlock FontSize="11.5" Foreground="{StaticResource Warning}" Text="{Binding StatusText}" />
                                        </Border>
                                    </Panel>
                                    <Panel Grid.Column="4" HorizontalAlignment="Left" VerticalAlignment="Center" ToolTip.Tip="{Binding CommunityNote}">
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource Success}" Text="{Binding CommunityText}" IsVisible="{Binding CommunityWorks}" />
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource Danger}" Text="{Binding CommunityText}" IsVisible="{Binding CommunityBroken}" />
                                        <TextBlock FontSize="11.5" Foreground="{StaticResource TextFaint}" Text="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[mod.community.unknown]}"
                                                   IsVisible="{Binding Community, Converter={x:Static vm:ModConverters.IsUnknown}}" />
                                        <TextBlock FontSize="10.5" Foreground="{StaticResource TextDim}" Text="{Binding VotesText}" Margin="0,16,0,0" />
                                    </Panel>
                                    <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Right" IsVisible="{Binding CanReport}">
                                        <Button Padding="7,4" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[mods.reportWorks]}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ReportModWorksCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource Success}" StrokeThickness="2" Width="11" Height="11" Stretch="Uniform" />
                                        </Button>
                                        <Button Padding="7,4" ToolTip.Tip="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).L[mods.reportBroken]}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).ReportModBrokenCommand}"
                                                CommandParameter="{Binding}">
                                            <Path Data="{StaticResource IconClose}" Stroke="{StaticResource Danger}" StrokeThickness="2" Width="10" Height="10" Stretch="Uniform" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                          </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Classes="hint" Margin="14" Text="{Binding L[msg.modulesUnknown]}" IsVisible="{Binding !HasModules}" />

                <!-- Sayfalama -->
                <Grid ColumnDefinitions="*,Auto" Margin="14,10,14,6">
                    <TextBlock Classes="dim" FontSize="12" VerticalAlignment="Center" Text="{Binding ModsRangeText}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" IsVisible="{Binding ModsHasPages}">
                        <Button Classes="page" Command="{Binding ModsPrevPageCommand}" Content="{Binding L[mods.page.prev]}" />
                        <ItemsControl ItemsSource="{Binding ModsPageLinks}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="4" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ModsPageLink">
                                    <Panel>
                                        <TextBlock Classes="dim" Text="…" VerticalAlignment="Center" Margin="4,0" IsVisible="{Binding IsGap}" />
                                        <Button Classes="page" Classes.primary="{Binding IsCurrent}" IsVisible="{Binding IsLink}" Content="{Binding Label}"
                                                Command="{Binding $parent[ItemsControl].((vm:MainViewModel)DataContext).GoToModsPageCommand}"
                                                CommandParameter="{Binding}" />
                                    </Panel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Button Classes="page" Command="{Binding ModsNextPageCommand}" Content="{Binding L[mods.page.next]}" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
