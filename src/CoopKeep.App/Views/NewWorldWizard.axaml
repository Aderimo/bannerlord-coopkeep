<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             xmlns:pages="using:CoopKeep.App.Views.Pages"
             xmlns:saves="using:CoopKeep.Core.Saves"
             x:Class="CoopKeep.App.Views.NewWorldWizard"
             x:DataType="vm:MainViewModel">

  <!--
      Oyundaki "Yeni kampanya" akışının karşılığı: ad → zorluk → kurallar → modlar →
      sunucu ve özet. Her adım tek bir karar ister. Sonunda "Oluştur ve oyna" ya da
      "Yalnızca oluştur".
  -->
  <Border Background="#D9090A0D">
    <Border Classes="enter" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1" CornerRadius="16" Width="860" MaxHeight="700" Margin="24"
            VerticalAlignment="Stretch" HorizontalAlignment="Center" BoxShadow="0 24 80 0 #99000000">
      <Grid RowDefinitions="Auto,Auto,*,Auto">

        <!-- Başlık -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="30,24,22,12">
            <StackPanel Spacing="4">
                <TextBlock Classes="eyebrow" Text="{Binding WizardStepText}" />
                <TextBlock Classes="h1" Text="{Binding L[wiz.title]}" />
            </StackPanel>
            <Button Grid.Column="1" Classes="ghost" VerticalAlignment="Top" Padding="8"
                    Command="{Binding CloseWizardCommand}" IsEnabled="{Binding !WizardCreating}">
                <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextDim}" StrokeThickness="2"
                      Width="12" Height="12" Stretch="Uniform" />
            </Button>
        </Grid>

        <!-- Adım çubuğu -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*,*,*,*" Margin="30,0,30,6">
            <StackPanel Grid.Column="0" Spacing="6">
                <Border Classes="stepbar" Classes.done="{Binding WizardStep, Converter={x:Static vm:Formatters.StepReached}, ConverterParameter=0}" Margin="0,0,4,0" />
                <TextBlock FontSize="11.5" Text="{Binding L[wiz.s0]}" Classes="dim" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="6">
                <Border Classes="stepbar" Classes.done="{Binding WizardStep, Converter={x:Static vm:Formatters.StepReached}, ConverterParameter=1}" Margin="2,0" />
                <TextBlock FontSize="11.5" Text="{Binding L[wiz.s1]}" Classes="dim" Margin="2,0" />
            </StackPanel>
            <StackPanel Grid.Column="2" Spacing="6">
                <Border Classes="stepbar" Classes.done="{Binding WizardStep, Converter={x:Static vm:Formatters.StepReached}, ConverterParameter=2}" Margin="2,0" />
                <TextBlock FontSize="11.5" Text="{Binding L[wiz.s2]}" Classes="dim" Margin="2,0" />
            </StackPanel>
            <StackPanel Grid.Column="3" Spacing="6">
                <Border Classes="stepbar" Classes.done="{Binding WizardStep, Converter={x:Static vm:Formatters.StepReached}, ConverterParameter=3}" Margin="2,0" />
                <TextBlock FontSize="11.5" Text="{Binding L[wiz.s3]}" Classes="dim" Margin="2,0" />
            </StackPanel>
            <StackPanel Grid.Column="4" Spacing="6">
                <Border Classes="stepbar" Classes.done="{Binding WizardStep, Converter={x:Static vm:Formatters.StepReached}, ConverterParameter=4}" Margin="4,0,0,0" />
                <TextBlock FontSize="11.5" Text="{Binding L[wiz.s4]}" Classes="dim" Margin="4,0,0,0" />
            </StackPanel>
        </Grid>

        <!-- İçerik -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <Panel Margin="30,14,30,10">

            <!-- ===== 0 · Ad ===== -->
            <StackPanel Classes="enter" Spacing="12" IsVisible="{Binding WizardStep0}" MaxWidth="560" HorizontalAlignment="Left">
                <TextBlock Classes="h2" Text="{Binding L[wiz.name.q]}" />
                <TextBlock Classes="hint" Text="{Binding L[wiz.name.hint]}" />
                <TextBox Text="{Binding WizardName}" FontSize="16" Padding="14,11" MaxLength="64" />
                <TextBlock Foreground="{StaticResource Danger}" FontSize="12.5" Text="{Binding WizardNameError}"
                           IsVisible="{Binding WizardHasNameError}" />

                <!-- Yeni dünya ya da tek oyunculu bir kampanyayı sürdürmek -->
                <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,6,0,0">
                    <RadioButton GroupName="wizStart" IsChecked="{Binding WizardNew}" Content="{Binding L[wiz.start.new]}" />
                    <RadioButton GroupName="wizStart" IsChecked="{Binding WizardImport}" Content="{Binding L[wiz.start.import]}" />
                </StackPanel>
                <StackPanel Spacing="10" IsVisible="{Binding WizardImport}">
                    <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding L[wiz.start.import.desc]}" />
                    <TextBlock Classes="hint" Text="{Binding L[wiz.import.none]}" IsVisible="{Binding !HasSinglePlayerSaves}" />
                    <ListBox ItemsSource="{Binding SinglePlayerSaves}" SelectedItem="{Binding SelectedImportSave}"
                             MaxHeight="170" IsVisible="{Binding HasSinglePlayerSaves}">
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="saves:SaveSet">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Classes="dim"
                                               Text="{Binding LastModifiedLocal, StringFormat='{}{0:dd.MM.yyyy HH:mm}'}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Classes="inset" IsVisible="{Binding HasImportInfo}">
                        <StackPanel Spacing="8">
                            <TextBlock Classes="body" Text="{Binding ImportSummary}" />
                            <TextBlock Classes="body" TextWrapping="Wrap" Foreground="{StaticResource Danger}"
                                       Text="{Binding ImportProblem}" IsVisible="{Binding ImportBlocked}" />
                            <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding ImportWarning}" IsVisible="{Binding HasImportWarning}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- ===== 1 · Zorluk ===== -->
            <Panel Classes="enter" IsVisible="{Binding WizardStep1}">
                <pages:WorldSettingsPanel DataContext="{Binding WizardSettings}" ShowRules="False"
                                          PresetGroup="wizPreset" ExpandDetails="False" />
            </Panel>

            <!-- ===== 2 · Kurallar ===== -->
            <StackPanel Classes="enter" Spacing="10" IsVisible="{Binding WizardStep2}">
                <TextBlock Classes="hint" Text="{Binding L[wiz.rules.hint]}" />
                <pages:WorldSettingsPanel DataContext="{Binding WizardSettings}" ShowDifficulty="False" />
            </StackPanel>

            <!-- ===== 3 · Modlar ===== -->
            <StackPanel Classes="enter" Spacing="12" IsVisible="{Binding WizardStep3}">
                <TextBlock Classes="h2" Text="{Binding L[wiz.mods.q]}" />
                <TextBlock Classes="hint" TextWrapping="Wrap" Text="{Binding L[wiz.mods.hint]}" />
                <ToggleSwitch IsChecked="{Binding WizardModded}"
                              OnContent="{Binding L[wiz.mods.on]}" OffContent="{Binding L[wiz.mods.off]}" />
                <TextBlock Classes="hint" Text="{Binding L[wiz.mods.none]}" IsVisible="{Binding !HasWizardMods}" />
                <Border Classes="inset" IsVisible="{Binding HasWizardMods}" IsEnabled="{Binding WizardModded}">
                    <ItemsControl ItemsSource="{Binding WizardMods}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:WorldModOption">
                                <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                    <CheckBox IsChecked="{Binding IsSelected}" Content="{Binding Id}" />
                                    <TextBlock Grid.Column="1" Classes="dim" VerticalAlignment="Center" Text="{Binding Version}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>
            </StackPanel>

            <!-- ===== 4 · Sunucu ve özet ===== -->
            <StackPanel Classes="enter" Spacing="16" IsVisible="{Binding WizardStep4}">
                <Border Classes="inset">
                    <StackPanel Spacing="14">
                        <TextBlock Classes="h2" Text="{Binding L[wiz.server]}" />
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.passwordHint]}"><TextBlock Text="{Binding L[lbl.password]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                            <TextBox Grid.Column="1" Width="220" Text="{Binding EditPassword}" PasswordChar="•"
                                     RevealPassword="{Binding !PrivacyMode}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[msg.autosaveHint]}"><TextBlock Text="{Binding L[lbl.autosave]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                            <TextBox Grid.Column="1" Classes="bar" Text="{Binding EditAutosave}" VerticalAlignment="Center" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,20,0" VerticalAlignment="Center" Background="Transparent" ToolTip.Tip="{Binding L[settings.portHint]}"><TextBlock Text="{Binding L[lbl.port]}" FontWeight="SemiBold" FontSize="13.5" VerticalAlignment="Center" /><Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextFaint}" StrokeThickness="1.6" Width="13" Height="13" Stretch="Uniform" VerticalAlignment="Center" /></StackPanel>
                            <TextBox Grid.Column="1" Classes="bar" Text="{Binding EditPort}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Classes="inset" Background="{StaticResource AccentSoft}">
                    <StackPanel Spacing="8">
                        <TextBlock Classes="eyebrow" Text="{Binding L[wiz.summary]}" />
                        <TextBlock Classes="h1" Text="{Binding WizardName}" />
                        <TextBlock Classes="body" Text="{Binding WizardSettings.Summary}" />
                    </StackPanel>
                </Border>

                <!-- Nasıl başlasın: alttaki iki düğmenin açıklaması -->
                <StackPanel Spacing="10" IsVisible="{Binding !WizardCreating}">
                    <TextBlock Classes="h2" Text="{Binding L[wiz.how]}" />
                    <UniformGrid Columns="2">
                        <Border Classes="inset" Margin="0,0,6,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L[wiz.play]}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Classes="hint" Text="{Binding L[wiz.play.desc]}" />
                            </StackPanel>
                        </Border>
                        <Border Classes="inset" Margin="6,0,0,0">
                            <StackPanel Spacing="6">
                                <TextBlock Text="{Binding L[wiz.only]}" FontWeight="SemiBold" FontSize="14" />
                                <TextBlock Classes="hint" Text="{Binding L[wiz.only.desc]}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>

                <!-- Kuruluyor -->
                <StackPanel Spacing="10" IsVisible="{Binding WizardCreating}">
                    <Grid ColumnDefinitions="Auto,*">
                        <Path Classes="spin" Data="M12,2 A10,10 0 0 1 22,12" Stroke="{StaticResource Accent}"
                              StrokeThickness="2.6" StrokeLineCap="Round" Width="24" Height="24" Stretch="None"
                              RenderTransformOrigin="50%,50%" />
                        <StackPanel Grid.Column="1" Margin="12,0,0,0" Spacing="2">
                            <TextBlock Classes="h2" Text="{Binding L[msg.creating]}" />
                            <TextBlock Classes="dim" Text="{Binding StatusText}" />
                        </StackPanel>
                    </Grid>
                    <ProgressBar Value="{Binding BootProgress}" Maximum="100" Height="6" />
                </StackPanel>
            </StackPanel>
          </Panel>
        </ScrollViewer>

        <!-- Alt çubuk -->
        <Border Grid.Row="3" BorderBrush="{StaticResource BorderDim}" BorderThickness="0,1,0,0" Padding="30,16">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <Button Command="{Binding WizardBackCommand}" IsVisible="{Binding WizardCanGoBack}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Path Classes="icon" Data="{StaticResource IconArrowLeft}" Width="14" />
                        <TextBlock Text="{Binding L[btn.back]}" />
                    </StackPanel>
                </Button>
                <Button Grid.Column="2" Classes="primary" Command="{Binding WizardNextCommand}"
                        IsVisible="{Binding WizardNotLastStep}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding L[btn.next]}" />
                        <Path Classes="icon" Data="{StaticResource IconArrowRight}" Width="14" />
                    </StackPanel>
                </Button>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" IsVisible="{Binding WizardIsLastStep}">
                    <Button Command="{Binding WizardCreateOnlyCommand}" ToolTip.Tip="{Binding L[wiz.only.desc]}">
                        <TextBlock Text="{Binding L[wiz.only]}" />
                    </Button>
                    <Button Classes="primary big" Command="{Binding WizardCreateAndPlayCommand}" ToolTip.Tip="{Binding L[wiz.play.desc]}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Path Data="{StaticResource IconPlay}" Fill="{StaticResource OnAccent}" Width="12" Height="12" Stretch="Uniform" />
                            <TextBlock Text="{Binding L[wiz.play]}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
      </Grid>
    </Border>
  </Border>
  <UserControl.Styles>
    <Style Selector="Border.stepbar">
        <Setter Property="Height" Value="4" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="Background" Value="{StaticResource BorderDim}" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.3" />
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.stepbar.done">
        <Setter Property="Background" Value="{StaticResource Accent}" />
    </Style>
  </UserControl.Styles>
</UserControl>
