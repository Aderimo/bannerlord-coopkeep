<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:CoopKeep.App.ViewModels"
             x:Class="CoopKeep.App.Views.PreflightOverlay"
             x:DataType="vm:MainViewModel">

  <!--
      Sunucuyu açmadan önce: Coop'un bilinen tuzaklarından biri varsa söylenir. Hata varsa
      açılmaz; uyarıda kullanıcı "yine de başlat" diyebilir.
  -->
  <Border Background="#E6090A0D">
    <Border Classes="enter" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderDim}"
            BorderThickness="1" CornerRadius="16" Width="640" Margin="24"
            VerticalAlignment="Center" HorizontalAlignment="Center" BoxShadow="0 24 80 0 #99000000">
      <StackPanel Margin="30,26,30,22" Spacing="14">
        <StackPanel Spacing="6">
            <TextBlock Classes="eyebrow" Text="{Binding L[preflight.eyebrow]}" />
            <TextBlock Classes="h1" Text="{Binding L[preflight.title]}" />
        </StackPanel>

        <ItemsControl ItemsSource="{Binding PreflightChecks}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:CheckRow">
                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,5">
                        <Panel Width="14" Height="14" Margin="0,2,10,0" VerticalAlignment="Top">
                            <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource Accent}" StrokeThickness="2" Stretch="Uniform" IsVisible="{Binding IsWarning}" />
                            <Path Data="{StaticResource IconClose}" Stroke="{StaticResource Danger}" StrokeThickness="2.2" Stretch="Uniform" IsVisible="{Binding IsError}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Classes="body" TextWrapping="Wrap" Text="{Binding Text}" />
                        <Button Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Top" IsVisible="{Binding HasFix}"
                                Command="{Binding $parent[UserControl].((vm:MainViewModel)DataContext).RunCheckFixCommand}"
                                CommandParameter="{Binding Fix}" Content="{Binding FixLabel}" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <Button Command="{Binding PreflightCancelCommand}" Content="{Binding L[btn.cancel]}" />
            <Button Classes="primary" IsVisible="{Binding PreflightCanContinue}" Command="{Binding PreflightContinueCommand}"
                    Content="{Binding L[preflight.continue]}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>
</UserControl>
