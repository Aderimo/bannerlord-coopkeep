<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:CoopKeep.App.ViewModels"
        xmlns:pages="using:CoopKeep.App.Views.Pages"
        xmlns:views="using:CoopKeep.App.Views"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="800"
        x:Class="CoopKeep.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="CoopKeep"
        Icon="/Assets/coopkeep.ico"
        Width="1280" Height="820"
        MinWidth="1040" MinHeight="680">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

  <Panel>
    <Grid ColumnDefinitions="232,*">

        <!-- ================= YAN MENÜ ================= -->
        <Border Grid.Column="0" Background="{StaticResource BgNav}"
                BorderBrush="{StaticResource BorderDim}" BorderThickness="0,0,1,0">
            <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="14,18,14,14">

                <!-- Logo -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="11" Margin="6,0,0,22">
                    <Border Width="36" Height="36" CornerRadius="10" Background="{StaticResource AccentSoft}"
                            BorderBrush="{StaticResource AccentDim}" BorderThickness="1">
                        <Path Data="{StaticResource IconShield}" Stroke="{StaticResource Accent}"
                              StrokeThickness="1.9" Width="19" Height="19" Stretch="Uniform"
                              StrokeJoin="Round" />
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="CoopKeep" FontSize="16" FontWeight="Bold"
                                   Foreground="{StaticResource TextMain}" />
                        <TextBlock Text="{Binding AppVersion}" FontSize="11"
                                   Foreground="{StaticResource TextFaint}" />
                    </StackPanel>
                </StackPanel>

                <!-- Durum kapsülü: her sayfadan görünür -->
                <Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="10"
                        BorderBrush="{StaticResource BorderDim}" BorderThickness="1"
                        Padding="12,10" Margin="0,0,0,18">
                    <Grid ColumnDefinitions="Auto,*">
                        <Panel Width="12" Height="12" VerticalAlignment="Center">
                            <Border Classes="pulse" Width="10" Height="10" CornerRadius="5"
                                    Background="{Binding StatusBrush}" IsVisible="{Binding IsServing}"
                                    RenderTransformOrigin="50%,50%" />
                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding StatusBrush}">
                                <Border.Transitions>
                                    <Transitions>
                                        <BrushTransition Property="Background" Duration="0:0:0.4" />
                                    </Transitions>
                                </Border.Transitions>
                            </Border>
                        </Panel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" Spacing="1">
                            <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Classes="dim" FontSize="11.5" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SidebarWorldName}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Sayfalar -->
                <StackPanel Grid.Row="2" Spacing="3">
                    <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageHome}" IsVisible="{Binding !IsViewerMode}">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="icon" Data="{StaticResource IconHome}" />
                            <TextBlock Text="{Binding L[nav.home]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageWorlds}" IsVisible="{Binding !IsViewerMode}">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="icon" Data="{StaticResource IconGlobe}" />
                            <TextBlock Text="{Binding L[nav.worlds]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageMods}" IsVisible="{Binding !IsViewerMode}">
                        <RadioButton.Tag>
                            <Border Classes="badge" Background="{StaticResource DangerSoft}" Padding="7,1"
                                    IsVisible="{Binding ModuleProblem}">
                                <TextBlock Text="!" FontSize="11" FontWeight="Bold"
                                           Foreground="{StaticResource Danger}" />
                            </Border>
                        </RadioButton.Tag>
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="icon" Data="{StaticResource IconPuzzle}" />
                            <TextBlock Text="{Binding L[nav.mods]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PagePlayers}" IsVisible="{Binding !IsViewerMode}">
                        <RadioButton.Tag>
                            <Border Classes="badge" Background="{StaticResource SuccessSoft}" Padding="7,1"
                                    IsVisible="{Binding HasPlayers}">
                                <TextBlock Text="{Binding OnlinePlayerCount}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Success}" />
                            </Border>
                        </RadioButton.Tag>
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="icon" Data="{StaticResource IconUsers}" />
                            <TextBlock Text="{Binding L[nav.players]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageBackups}" IsVisible="{Binding !IsViewerMode}">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="icon" Data="{StaticResource IconArchive}" />
                            <TextBlock Text="{Binding L[nav.backups]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageGuide}">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="icon" Data="{StaticResource IconInfo}" />
                            <TextBlock Text="{Binding L[nav.guide]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageSettings}">
                        <StackPanel Orientation="Horizontal" Spacing="11">
                            <Path Classes="icon" Data="{StaticResource IconSliders}" />
                            <TextBlock Text="{Binding L[nav.settings]}" VerticalAlignment="Center" />
                        </StackPanel>
                    </RadioButton>

                    <Border Height="1" Background="{StaticResource BorderDim}" Margin="8,10" />

                    <!-- Araçlar: ileri düzey sayfalar; kapalıyken ana yol sade kalır -->
                    <ToggleButton Classes="disclosure navgroup" IsChecked="{Binding ToolsExpanded}" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="{Binding L[nav.toolsTip]}">
                        <Grid ColumnDefinitions="*,Auto" Margin="12,0,8,0">
                            <TextBlock Classes="dim" FontSize="11.5" FontWeight="SemiBold" Text="{Binding L[nav.tools]}" VerticalAlignment="Center" />
                            <Panel Grid.Column="1" VerticalAlignment="Center">
                                <Path Data="M6,9 L12,15 L18,9" IsVisible="{Binding !$parent[ToggleButton].IsChecked}" Stroke="{StaticResource TextDim}" StrokeThickness="2"
                                  Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" StrokeJoin="Round" />
                                <Path Data="M6,15 L12,9 L18,15" IsVisible="{Binding $parent[ToggleButton].IsChecked}" Stroke="{StaticResource TextDim}" StrokeThickness="2"
                                  Width="10" Height="10" Stretch="Uniform" StrokeLineCap="Round" StrokeJoin="Round" />
                            </Panel>
                        </Grid>
                    </ToggleButton>
                    <StackPanel Spacing="3" IsVisible="{Binding ToolsExpanded}">
                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageCheats}" IsVisible="{Binding !IsViewerMode}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Path Classes="icon" Data="{StaticResource IconSparkle}" />
                                <TextBlock Text="{Binding L[nav.cheats]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageMap}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Path Classes="icon" Data="{StaticResource IconMap}" />
                                <TextBlock Text="{Binding L[nav.map]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageEncyclopedia}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Path Classes="icon" Data="{StaticResource IconBook}" />
                                <TextBlock Text="{Binding L[nav.encyclopedia]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton Classes="nav" GroupName="nav" IsChecked="{Binding PageConsole}" IsVisible="{Binding !IsViewerMode}">
                            <StackPanel Orientation="Horizontal" Spacing="11">
                                <Path Classes="icon" Data="{StaticResource IconTerminal}" />
                                <TextBlock Text="{Binding L[nav.console]}" VerticalAlignment="Center" />
                            </StackPanel>
                        </RadioButton>
                    </StackPanel>
                </StackPanel>

                <!-- Alt: gizlilik, dil, geliştirici -->
                <StackPanel Grid.Row="3" Spacing="10">
                    <Grid ColumnDefinitions="*,6,Auto">
                        <Button Grid.Column="0" Command="{Binding TogglePrivacyCommand}"
                                HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                ToolTip.Tip="{Binding L[msg.privacyHint]}" Padding="10,7">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Panel Width="16" Height="16">
                                    <Path Data="{StaticResource IconEye}" Stroke="{Binding PrivacyIconBrush}"
                                          StrokeThickness="1.7" Stretch="Uniform" />
                                    <Path Data="M3,21 L21,3" Stroke="{Binding PrivacyIconBrush}" Stretch="Fill"
                                          StrokeThickness="1.9" IsVisible="{Binding PrivacyMode}" />
                                </Panel>
                                <TextBlock FontSize="12" VerticalAlignment="Center"
                                           Text="{Binding PrivacyLabel}" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" Command="{Binding ToggleLanguageCommand}" Padding="10,7"
                                MinWidth="44">
                            <TextBlock Text="{Binding L[lang.label]}" FontSize="12" HorizontalAlignment="Center" />
                        </Button>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" Margin="6,0,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <TextBlock Classes="dim" FontSize="11" Text="{Binding L[lbl.madeBy]}" VerticalAlignment="Center" />
                        <Button Classes="ghost" Command="{Binding OpenAuthorPageCommand}" Padding="2,0"
                                ToolTip.Tip="{Binding AuthorUrl}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding AuthorName}" FontSize="11" FontWeight="SemiBold"
                                           Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                                <Path Data="{StaticResource IconGlobe}" Stroke="{StaticResource Accent}" StrokeThickness="1.8"
                                      Width="10" Height="10" Stretch="Uniform" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <!-- Bildirim geçmişi (zil) -->
                    <Button Grid.Column="1" Classes="ghost" Padding="6,3" Command="{Binding MarkToastsSeenCommand}" ToolTip.Tip="{Binding L[notif.title]}">
                        <Panel>
                            <Path Data="{StaticResource IconBell}" Stroke="{StaticResource TextDim}" StrokeThickness="1.7"
                                  Width="14" Height="14" Stretch="Uniform" />
                            <Border Background="{StaticResource Danger}" CornerRadius="6" MinWidth="12" Height="12" Padding="3,0"
                                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-8,0" IsVisible="{Binding HasUnseenToasts}">
                                <TextBlock Text="{Binding UnseenToasts}" FontSize="8.5" FontWeight="Bold" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </Panel>
                        <Button.Flyout>
                            <Flyout Placement="TopEdgeAlignedLeft">
                                <StackPanel Width="380" Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Classes="h2" Text="{Binding L[notif.title]}" VerticalAlignment="Center" />
                                        <Button Grid.Column="1" Classes="ghost small" Command="{Binding ClearToastHistoryCommand}"
                                                Content="{Binding L[notif.clear]}" IsVisible="{Binding HasToastHistory}" />
                                    </Grid>
                                    <TextBlock Classes="hint" Text="{Binding L[notif.empty]}" IsVisible="{Binding !HasToastHistory}" />
                                    <ScrollViewer MaxHeight="420" IsVisible="{Binding HasToastHistory}">
                                        <ItemsControl ItemsSource="{Binding ToastHistory}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ToastRecord">
                                                    <Grid ColumnDefinitions="Auto,*" Margin="0,4">
                                                        <Panel Width="8" Height="8" Margin="0,5,10,0" VerticalAlignment="Top">
                                                            <Ellipse Fill="{StaticResource Success}" IsVisible="{Binding IsNormal}" />
                                                            <Ellipse Fill="{StaticResource Warning}" IsVisible="{Binding IsWarning}" />
                                                            <Ellipse Fill="{StaticResource Danger}" IsVisible="{Binding IsError}" />
                                                        </Panel>
                                                        <StackPanel Grid.Column="1" Spacing="1">
                                                            <TextBlock Classes="body" FontSize="12.5" TextWrapping="Wrap" Text="{Binding Text}" />
                                                            <TextBlock Classes="dim" FontSize="10.5" Text="{Binding Time}" />
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= SAYFA ALANI ================= -->
        <Grid Grid.Column="1" RowDefinitions="Auto,*">

            <!-- Başka bir sunucu açıksa: her sayfanın üstünde -->
            <Border Grid.Row="0" Background="{StaticResource DangerSoft}" BorderBrush="{StaticResource Danger}"
                    BorderThickness="0,0,0,1" Padding="20,10" IsVisible="{Binding HasForeignServer}">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <Path Classes="icon" Data="{StaticResource IconWarn}" Stroke="{StaticResource Danger}" />
                    <TextBlock Grid.Column="1" Margin="10,0" Text="{Binding ForeignServerWarning}"
                               TextWrapping="Wrap" FontSize="12.5" Foreground="#F5C2C2" VerticalAlignment="Center" />
                    <Button Grid.Column="2" Command="{Binding RefreshCommand}" Content="{Binding L[btn.refresh]}"
                            Padding="10,5" FontSize="12" />
                </Grid>
            </Border>

            <TransitioningContentControl Grid.Row="1" Name="PageHost">
                <TransitioningContentControl.PageTransition>
                    <CrossFade Duration="0:0:0.18" />
                </TransitioningContentControl.PageTransition>
            </TransitioningContentControl>
        </Grid>
    </Grid>

    <!-- ================= BİLDİRİMLER ================= -->
    <ItemsControl ItemsSource="{Binding Toasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                  Margin="0,0,22,22" Width="360">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Spacing="8" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:Toast">
                <Border Classes="toast" Classes.leaving="{Binding IsLeaving}"
                        Background="{StaticResource BgRaised}" BorderBrush="{StaticResource BorderDim}"
                        BorderThickness="1" CornerRadius="10" Padding="14,11"
                        BoxShadow="0 8 28 0 #66000000">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <Panel Width="20" Height="20" VerticalAlignment="Top" Margin="0,1,0,0">
                            <Path Data="{StaticResource IconCheck}" Stroke="{StaticResource Success}"
                                  StrokeThickness="2" Stretch="Uniform" Width="15" IsVisible="{Binding IsSuccess}" />
                            <Path Data="{StaticResource IconWarn}" Stroke="{StaticResource Warning}"
                                  StrokeThickness="1.8" Stretch="Uniform" Width="16" IsVisible="{Binding IsWarning}" />
                            <Path Data="{StaticResource IconWarn}" Stroke="{StaticResource Danger}"
                                  StrokeThickness="1.8" Stretch="Uniform" Width="16" IsVisible="{Binding IsError}" />
                            <Path Data="{StaticResource IconInfo}" Stroke="{StaticResource TextDim}"
                                  StrokeThickness="1.8" Stretch="Uniform" Width="16" IsVisible="{Binding IsInfo}" />
                        </Panel>
                        <TextBlock Grid.Column="1" Margin="10,0,8,0" Text="{Binding Text}" TextWrapping="Wrap"
                                   FontSize="12.5" Foreground="{StaticResource TextMain}" LineHeight="18" />
                        <Button Grid.Column="2" Classes="ghost" Padding="4" VerticalAlignment="Top"
                                Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).DismissToastCommand}"
                                CommandParameter="{Binding}">
                            <Path Data="{StaticResource IconClose}" Stroke="{StaticResource TextFaint}"
                                  StrokeThickness="1.8" Width="10" Height="10" Stretch="Uniform" />
                        </Button>
                    </Grid>
                </Border>
            </DataTemplate>
        </ItemsControl.ItemTemplate>
        <ItemsControl.Styles>
            <Style Selector="Border.toast">
                <Setter Property="RenderTransform" Value="translate(0px,0px)" />
                <Setter Property="Transitions">
                    <Transitions>
                        <DoubleTransition Property="Opacity" Duration="0:0:0.25" />
                        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.25" Easing="CubicEaseIn" />
                    </Transitions>
                </Setter>
                <Style.Animations>
                    <Animation Duration="0:0:0.32" Easing="BackEaseOut" FillMode="Both">
                        <KeyFrame Cue="0%">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="TranslateTransform.X" Value="40" />
                        </KeyFrame>
                        <KeyFrame Cue="100%">
                            <Setter Property="Opacity" Value="1" />
                            <Setter Property="TranslateTransform.X" Value="0" />
                        </KeyFrame>
                    </Animation>
                </Style.Animations>
            </Style>
            <Style Selector="Border.toast.leaving">
                <Setter Property="Opacity" Value="0" />
                <Setter Property="RenderTransform" Value="translate(40px,0px)" />
            </Style>
        </ItemsControl.Styles>
    </ItemsControl>

    <!-- ================= EŞYA EKRANI ================= -->
    <views:ItemBrowser IsVisible="{Binding ItemBrowserOpen}" />

    <!-- ================= OYUNCU PROFİLİ ================= -->
    <views:PlayerProfile IsVisible="{Binding ProfileOpen}" />

    <!-- ================= MOD BİLGİSİ ================= -->
    <views:ModInfoOverlay IsVisible="{Binding ModInfoOpen}" />

    <!-- ================= İZLEYİCİ BAĞLANTISI ================= -->
    <views:ViewerConnectOverlay IsVisible="{Binding ViewerConnectOpen}" />

    <!-- ================= YENİ DÜNYA SİHİRBAZI ================= -->
    <views:NewWorldWizard IsVisible="{Binding WizardOpen}" />

    <!-- ================= SUNUCU LİSANS ONAYI ================= -->
    <views:EulaOverlay IsVisible="{Binding EulaOpen}" />
    <views:PreflightOverlay IsVisible="{Binding PreflightOpen}" />

    <!-- ================= KARŞILAMA ================= -->
    <views:WelcomeOverlay IsVisible="{Binding ShowTutorial}" />
  </Panel>
</Window>
