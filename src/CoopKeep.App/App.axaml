<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="CoopKeep.App.App"
             xmlns:local="using:CoopKeep.App"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- Koyu palet. Bannerlord'un sıcak/toprak tonlarına yakın bir gri-kahve zemin. -->
        <SolidColorBrush x:Key="BgDeep"    Color="#14161A" />
        <SolidColorBrush x:Key="BgPanel"   Color="#1C1F26" />
        <SolidColorBrush x:Key="BgRaised"  Color="#242832" />
        <SolidColorBrush x:Key="BorderDim" Color="#2E333F" />
        <SolidColorBrush x:Key="TextMain"  Color="#E6E8EC" />
        <SolidColorBrush x:Key="TextDim"   Color="#98A0AF" />
        <SolidColorBrush x:Key="Accent"    Color="#C9A227" />
        <SolidColorBrush x:Key="AccentDim" Color="#8A6F1B" />
        <SolidColorBrush x:Key="Danger"    Color="#DC5B5B" />
        <SolidColorBrush x:Key="ConsoleBg" Color="#0F1115" />
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <Style Selector="Window">
            <Setter Property="Background" Value="{StaticResource BgDeep}" />
            <Setter Property="FontFamily" Value="Segoe UI, Inter, sans-serif" />
        </Style>

        <!-- Panel: içeriği gruplayan kart -->
        <Style Selector="Border.panel">
            <Setter Property="Background" Value="{StaticResource BgPanel}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="14" />
        </Style>

        <Style Selector="TextBlock.h1">
            <Setter Property="FontSize" Value="19" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
        </Style>

        <Style Selector="TextBlock.h2">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style Selector="TextBlock.dim">
            <Setter Property="Foreground" Value="{StaticResource TextDim}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="TextBlock.value">
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <Style Selector="Button">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDim}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="MinWidth" Value="0" />
        </Style>

        <Style Selector="Button:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E333F" />
            <Setter Property="TextBlock.Foreground" Value="{StaticResource TextMain}" />
        </Style>

        <Style Selector="Button:disabled /template/ ContentPresenter">
            <Setter Property="Background" Value="#1A1D24" />
            <Setter Property="TextBlock.Foreground" Value="#5A6070" />
        </Style>

        <!-- Birincil eylem: başlat -->
        <Style Selector="Button.primary">
            <Setter Property="Background" Value="{StaticResource Accent}" />
            <Setter Property="Foreground" Value="#1A1608" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="BorderBrush" Value="{StaticResource AccentDim}" />
        </Style>

        <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#DFB633" />
            <Setter Property="TextBlock.Foreground" Value="#1A1608" />
        </Style>

        <Style Selector="Button.danger:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="{StaticResource Danger}" />
            <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
        </Style>

        <Style Selector="TextBox">
            <Setter Property="Background" Value="{StaticResource BgRaised}" />
            <Setter Property="Foreground" Value="{StaticResource TextMain}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderDim}" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Padding" Value="9,7" />
        </Style>

        <Style Selector="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="ListBoxItem">
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="CornerRadius" Value="6" />
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#2E333F" />
        </Style>
    </Application.Styles>
</Application>
